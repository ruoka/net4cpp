export namespace http {

using namespace std::string_literals;
using namespace std::string_view_literals;

// HTTP method constants
constexpr auto method_get = "GET"sv;
constexpr auto method_head = "HEAD"sv;
constexpr auto method_post = "POST"sv;
constexpr auto method_put = "PUT"sv;
constexpr auto method_patch = "PATCH"sv;
constexpr auto method_delete = "DELETE"sv;
constexpr auto method_options = "OPTIONS"sv;
constexpr auto method_ws = "WS"sv;
constexpr auto method_sse = "SSE"sv;

// HTTP status constants
const auto status_switching_protocols = "101 Switching Protocols"s;
const auto status_ok = "200 OK"s;
const auto status_created = "201 Created"s;
const auto status_accepted = "202 Accepted"s;
const auto status_no_content = "204 No Content"s;
const auto status_moved_permanently = "301 Moved Permanently"s;
const auto status_found = "302 Found"s;
const auto status_see_other = "303 See Other"s;
const auto status_not_modified = "304 Not Modified"s;
const auto status_temporary_redirect = "307 Temporary Redirect"s;
const auto status_permanent_redirect = "308 Permanent Redirect"s;
const auto status_bad_request = "400 Bad Request"s;
const auto status_unauthorized = "401 Unauthorized"s;
const auto status_forbidden = "403 Forbidden"s;
const auto status_not_found = "404 Not Found"s;
const auto status_method_not_allowed = "405 Method Not Allowed"s;
const auto status_not_acceptable = "406 Not Acceptable"s;
const auto status_conflict = "409 Conflict"s;
const auto status_gone = "410 Gone"s;
const auto status_precondition_failed = "412 Precondition Failed"s;
const auto status_request_timeout = "408 Request Timeout"s;
const auto status_payload_too_large = "413 Payload Too Large"s;
const auto status_unsupported_media_type = "415 Unsupported Media Type"s;
const auto status_expectation_failed = "417 Expectation Failed"s;
const auto status_unprocessable_entity = "422 Unprocessable Entity"s;
const auto status_too_many_requests = "429 Too Many Requests"s;
const auto status_request_header_fields_too_large = "431 Request Header Fields Too Large"s;
const auto status_internal_server_error = "500 Internal Server Error"s;
const auto status_not_implemented = "501 Not Implemented"s;
const auto status_bad_gateway = "502 Bad Gateway"s;
const auto status_service_unavailable = "503 Service Unavailable"s;
const auto status_gateway_timeout = "504 Gateway Timeout"s;

// Cap request-line + headers before they are buffered. Matches the WebSocket
// upgrade-response head limit; unbounded operator>> / getline can OOM a
// server before max_request_body_size applies.
inline constexpr auto default_max_request_head_size = std::size_t{16 * 1024};

// Cap Content-Length before the body is allocated. The previous default was
// unlimited, so one declared length near 2^63 allocated until bad_alloc.
// 1 MiB matches the YarDB limit. Raise it with max_request_body_size().
inline constexpr auto default_max_request_body_size = std::size_t{1024 * 1024};

// Idle gap between bytes on an accepted connection. Separate from server::timeout,
// which only wakes the accept poll. Zero blocks. WebSocket and SSE clear it
// when they take over the socket.
inline constexpr auto default_read_timeout = std::chrono::milliseconds{30'000};

// Whole request, from the first head byte through the last body byte. The idle
// gap alone lets one byte per 29s hold a slot for days. Zero disables it.
inline constexpr auto default_request_timeout = std::chrono::milliseconds{60'000};

// Longest wait for the client to accept response bytes. A client that stops
// reading otherwise blocks send() forever. Kept for WebSocket and SSE, where a
// stalled reader is the same problem. Zero blocks.
inline constexpr auto default_write_timeout = std::chrono::milliseconds{30'000};

// Handler threads for accepted connections. Each one is its own thread, so an
// open cap lets a Slowloris against the origin port spawn without bound.
// Zero means no cap.
inline constexpr auto default_max_connections = std::size_t{128};

// WebSocket and SSE connections hold their slot for as long as the peer stays,
// so without a separate cap they can take every slot from ordinary requests.
// Half of default_max_connections. Zero means no cap.
inline constexpr auto default_max_streaming_connections = std::size_t{64};

// Connections per peer address. Off by default: behind a reverse proxy every
// connection shares the proxy's address. Set it when the port is reachable
// directly, or one host can still take every slot. Zero means no cap.
inline constexpr auto default_max_connections_per_client = std::size_t{0};

// Default Server product token. gethostname() leaked the machine name.
// Override with server::server_token(); an empty token omits the header.
inline constexpr auto default_server_token = "net"sv;

// Protocol errors and 404s. "*/*" is not a media type and invites MIME sniffing.
inline constexpr auto error_content_type = "text/plain; charset=utf-8"sv;

using status = std::string;
using content = std::string;
using content_type = std::string;
// Handler return type. Exported so handlers and middlewares can name it, but its
// representation is not part of the API: create one with make_response() or
// make_error_response(), and read one only through a structured binding
// `auto [status, content, headers] = ...`. Brace construction, std::get and
// std::tie are unsupported and may stop compiling in a minor release.
using response_with_headers = std::tuple<status, content, std::optional<headers>>;
// Legacy alias for backwards compatibility - now just an alias to response_with_headers
using response = response_with_headers;
using response_with_content_type = std::tuple<status, content, content_type, std::optional<headers>>;
using request_view = std::string_view;
using body_view = std::string_view;

// Unified callback type - all handlers return response_with_headers (with optional headers)
// Note: headers is non-const to allow middlewares to modify headers in-place without copying
using callback = std::function<response_with_headers(request_view, body_view, headers&)>;
using callback_with_headers [[deprecated("use http::callback")]] = callback;

// What http::server knows about a request, as views into its own buffers. Valid
// only for the duration of the handler call. Nothing is parsed until asked:
// path(), query() and capture() split the target or rerun the route on demand.
struct request
{
    std::string_view method = {};
    std::string_view target = {};   // request-target as received (path + optional query)
    std::string_view peer = {};     // client address
    const std::regex* route = nullptr;

    std::string_view path() const
    {
        return target.substr(0, target.find('?'));
    }

    std::string_view query() const
    {
        const auto q = target.find('?');
        return q == std::string_view::npos ? std::string_view{} : target.substr(q + 1);
    }

    // First `key=value` (or bare `key`) in the query. The value is still
    // percent-encoded; decode it with net::url_decode when needed.
    std::optional<std::string_view> query(std::string_view key) const
    {
        for(const auto part : query() | std::views::split('&'))
        {
            const auto field = std::string_view{part};
            const auto eq = field.find('=');
            if(field.substr(0, eq) == key)
                return eq == std::string_view::npos ? std::string_view{} : field.substr(eq + 1);
        }
        return std::nullopt;
    }

    // Sub-match n of the route regex; 0 is the whole match. Normal routes match
    // the whole target, ws() and sse() routes only the path, so the path is
    // tried when the target does not match. Empty when there is no route, no
    // match, or no such group.
    std::string_view capture(std::size_t n) const
    {
        if(route == nullptr)
            return {};
        auto match = std::match_results<std::string_view::const_iterator>{};
        try
        {
            if(not std::regex_match(target.begin(), target.end(), match, *route))
            {
                const auto p = path();
                if(p.size() == target.size() or not std::regex_match(p.begin(), p.end(), match, *route))
                    return {};
            }
            if(n >= match.size() or not match[n].matched)
                return {};
        }
        catch(const std::regex_error&)
        {
            return {};
        }
        return {match[n].first, match[n].second};
    }
};

// Handler that receives the request as a struct. Register it with
// controller::response(); old-style callback handlers keep working alongside it.
using request_callback = std::function<response_with_headers(const request&, body_view, headers&)>;

namespace detail
{

inline std::string json_escape_string(std::string_view value)
{
    auto out = std::string{};
    out.reserve(value.size() + 8);
    for(unsigned char ch : value)
    {
        switch(ch)
        {
        case '"': out += "\\\""; break;
        case '\\': out += "\\\\"; break;
        case '\b': out += "\\b"; break;
        case '\f': out += "\\f"; break;
        case '\n': out += "\\n"; break;
        case '\r': out += "\\r"; break;
        case '\t': out += "\\t"; break;
        default:
            if(ch < 0x20)
                out += std::format("\\u{:04x}", ch);
            else
                out.push_back(static_cast<char>(ch));
            break;
        }
    }
    return out;
}

inline std::string json_error_body(std::string_view error, std::string_view message)
{
    return std::format(
        R"({{"error":"{}","message":"{}"}})",
        json_escape_string(error),
        json_escape_string(message));
}

} // namespace detail

// Standardized JSON error: {"error":"...","message":"..."}.
// Overloads keep (status, text, headers) call sites working — message defaults to error.
inline response_with_headers make_error_response(
    const status& status_code,
    std::string_view error,
    std::string_view message,
    std::optional<headers> custom_headers = std::nullopt)
{
    return {
        status_code,
        detail::json_error_body(error, message.empty() ? error : message),
        std::move(custom_headers)};
}

inline response_with_headers make_error_response(
    const status& status_code,
    std::string_view error,
    std::optional<headers> custom_headers)
{
    return make_error_response(status_code, error, error, std::move(custom_headers));
}

inline response_with_headers make_error_response(
    const status& status_code,
    std::string_view error)
{
    return make_error_response(status_code, error, error, std::nullopt);
}

// Helper function for responses with optional headers
// Uses default argument following C++ Core Guidelines (prefer default arguments over overloads)
inline response_with_headers make_response(
    const status& status_code,
    std::string content,
    std::optional<headers> custom_headers = std::nullopt)
{
    return {status_code, std::move(content), custom_headers};
}

// Host/Origin pattern match: exact, or `host:*` / `http://host:*` (port wildcard).
inline bool match_allow_pattern(std::string_view value, std::string_view pattern)
{
    if(not pattern.ends_with(":*"sv))
        return value == pattern;
    const auto prefix = pattern.substr(0, pattern.size() - 2);
    if(not value.starts_with(prefix))
        return false;
    const auto port = value.substr(prefix.size());
    return port.empty() or port.starts_with(':');
}

inline bool value_allowed(std::string_view value, std::span<const std::string> patterns)
{
    return std::ranges::any_of(patterns, [value](std::string_view p) { return match_allow_pattern(value, p); });
}

class server;

class controller
{
public:

    using callback = std::function<::http::response_with_headers(request_view, body_view, headers&)>;
    using websocket_callback = net::websocket::text_handler;
    using sse_callback = std::function<void(::http::sse::session&, request_view, headers&)>;
    // Same handlers with the request struct. The request stays valid for the
    // whole WebSocket or SSE session.
    using request_websocket_callback = std::function<net::websocket::text_reply(const ::http::request&, std::string_view)>;
    using request_sse_callback = std::function<void(::http::sse::session&, const ::http::request&, headers&)>;

    controller& text(const content& c)
    {
        m_content_type = "text/plain";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    controller& html(const content& c)
    {
        m_content_type = "text/html";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    controller& css(const content& c)
    {
        m_content_type = "text/css";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    controller& script(const content& c)
    {
        m_content_type = "application/javascript";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    controller& json(const content& c)
    {
        m_content_type = "application/json";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    controller& xml(const content& c)
    {
        m_content_type = "application/xml";
        m_callback = [c](auto&&...){ return make_response(status_ok, c); };
        return *this;
    }

    using request_callback = ::http::request_callback;

    // Takes either handler shape: (request_view, body_view, headers&), or
    // (const request&, body_view, headers&). The old shape is tested first, so
    // a generic (auto, auto, auto&) lambda keeps receiving the target string;
    // spell out const http::request& to get the struct.
    template<typename F>
        requires std::invocable<F&, request_view, body_view, headers&>
              or std::invocable<F&, const ::http::request&, body_view, headers&>
    controller& response(std::string_view ct, F&& handler)
    {
        m_content_type = std::string{ct};
        if constexpr(std::invocable<F&, request_view, body_view, headers&>)
            m_callback = [cb = callback{std::forward<F>(handler)}](const ::http::request& r, body_view body, headers& h)
            {
                return cb(r.target, body, h);
            };
        else
            m_callback = request_callback{std::forward<F>(handler)};
        return *this;
    }

    using callback_with_headers [[deprecated("use http::controller::callback")]] = callback;

    [[deprecated("use response(content_type, callback)")]]
    void response_handler(std::string_view ct, callback cb)
    {
        response(ct, std::move(cb));
    }

    [[deprecated("use response(content_type, callback)")]]
    void response_with_headers_handler(std::string_view ct, callback cb)
    {
        response(ct, std::move(cb));
    }

    [[deprecated("use response(content_type, callback)")]]
    controller& response_with_headers(std::string_view ct, callback cb)
    {
        return response(ct, std::move(cb));
    }

    response_with_content_type render(const ::http::request& r, body_view body, headers& h) const
    {
        auto [s, c, custom_h] = m_callback(r, body, h);
        return {std::move(s), std::move(c), m_content_type, std::move(custom_h)};
    }

    response_with_content_type render(request_view target, body_view body, headers& h) const
    {
        return render(::http::request{.target = target}, body, h);
    }

    // WebSocket text handler: payload in → optional text frame out (nullopt = no reply).
    // Takes (std::string_view message) or (const request&, std::string_view message).
    controller& ws(websocket_callback cb)
    {
        if(cb)
            m_ws_callback = [cb = std::move(cb)](const ::http::request&, std::string_view message) { return cb(message); };
        else
            m_ws_callback = {};
        return *this;
    }

    template<typename F>
        requires (not std::invocable<F&, std::string_view>)
             and std::invocable<F&, const ::http::request&, std::string_view>
    controller& ws(F&& cb)
    {
        m_ws_callback = request_websocket_callback{std::forward<F>(cb)};
        return *this;
    }

    [[nodiscard]] bool has_websocket() const noexcept
    {
        return static_cast<bool>(m_ws_callback);
    }

    [[deprecated("the server calls the handler with the request; this copy gets an empty one")]]
    [[nodiscard]] websocket_callback websocket_handler() const
    {
        if(not m_ws_callback)
            return {};
        return [cb = m_ws_callback](std::string_view message) { return cb(::http::request{}, message); };
    }

    // Server-Sent Events handler: connection takeover after SSE response head.
    // Takes (sse::session&, request_view, headers&) or (sse::session&, const request&, headers&).
    controller& sse(sse_callback cb)
    {
        if(cb)
            m_sse_callback = [cb = std::move(cb)](::http::sse::session& s, const ::http::request& r, headers& h) { cb(s, r.target, h); };
        else
            m_sse_callback = {};
        return *this;
    }

    template<typename F>
        requires (not std::invocable<F&, ::http::sse::session&, request_view, headers&>)
             and std::invocable<F&, ::http::sse::session&, const ::http::request&, headers&>
    controller& sse(F&& cb)
    {
        m_sse_callback = request_sse_callback{std::forward<F>(cb)};
        return *this;
    }

    [[nodiscard]] bool has_sse() const noexcept
    {
        return static_cast<bool>(m_sse_callback);
    }

    [[deprecated("the server calls the handler with the request; this copy gets an empty one")]]
    [[nodiscard]] sse_callback sse_handler() const
    {
        if(not m_sse_callback)
            return {};
        return [cb = m_sse_callback](::http::sse::session& s, request_view target, headers& h) { cb(s, ::http::request{.target = target}, h); };
    }

    // Same Origin allowlist predicate used with cors_middleware for OPTIONS.
    // When set, a permitted Origin is reflected on the SSE response head.
    controller& cors(std::function<bool(std::string_view)> allowed_origin)
    {
        m_cors_origin = std::move(allowed_origin);
        return *this;
    }

    [[nodiscard]] bool has_cors_origin() const noexcept
    {
        return static_cast<bool>(m_cors_origin);
    }

    [[nodiscard]] const std::function<bool(std::string_view)>& cors_origin() const noexcept
    {
        return m_cors_origin;
    }

    // Optional pre-check before a WebSocket upgrade or SSE response head is
    // written. Returning a response rejects the takeover (e.g. Host/Origin
    // DNS-rebinding guards).
    // Takes (request_view, headers&) or (const request&, headers&).
    using takeover_gate = std::function<std::optional<::http::response_with_headers>(request_view, headers&)>;
    using request_gate = std::function<std::optional<::http::response_with_headers>(const ::http::request&, headers&)>;
    using sse_gate [[deprecated("use http::controller::takeover_gate")]] = takeover_gate;

    controller& gate(takeover_gate g)
    {
        if(g)
            m_gate = [g = std::move(g)](const ::http::request& r, headers& h) { return g(r.target, h); };
        else
            m_gate = {};
        return *this;
    }

    template<typename F>
        requires (not std::invocable<F&, request_view, headers&>)
             and std::invocable<F&, const ::http::request&, headers&>
    controller& gate(F&& g)
    {
        m_gate = request_gate{std::forward<F>(g)};
        return *this;
    }

    [[nodiscard]] bool has_gate() const noexcept
    {
        return static_cast<bool>(m_gate);
    }

    [[nodiscard]] const request_gate& gate_handler() const noexcept
    {
        return m_gate;
    }

    [[deprecated("use gate_handler()")]]
    [[nodiscard]] takeover_gate sse_gate_fn() const
    {
        if(not m_gate)
            return {};
        return [g = m_gate](request_view target, headers& h) { return g(::http::request{.target = target}, h); };
    }

private:

    friend class server;

    // A route registered without a handler, e.g. server.post("/x") alone.
    content_type m_content_type{error_content_type};
    request_callback m_callback = [](const ::http::request&, body_view, headers&){ return make_response(status_not_found, ""s); };
    request_websocket_callback m_ws_callback;
    request_sse_callback m_sse_callback;
    std::function<bool(std::string_view)> m_cors_origin;
    request_gate m_gate;
};

class server
{
public:

    controller& get(std::string_view path)
    {
        m_methods.insert(method_get);
        return route_for(path)[method_get];
    }

    controller& head(std::string_view path)
    {
        m_methods.insert(method_head);
        return route_for(path)[method_head];
    }

    controller& post(std::string_view path)
    {
        m_methods.insert(method_post);
        return route_for(path)[method_post];
    }

    controller& put(std::string_view path)
    {
        m_methods.insert(method_put);
        return route_for(path)[method_put];
    }

    controller& patch(std::string_view path)
    {
        m_methods.insert(method_patch);
        return route_for(path)[method_patch];
    }

    controller& destroy(std::string_view path)
    {
        m_methods.insert(method_delete);
        return route_for(path)[method_delete];
    }

    // Optional explicit OPTIONS handler. When omitted, dispatch falls back to
    // GET (same as HEAD) so cors_middleware can answer preflight without running
    // the GET body; if there is no GET either, the server returns 204.
    controller& options(std::string_view path)
    {
        m_methods.insert(method_options);
        return route_for(path)[method_options];
    }

    // Register a WebSocket endpoint (upgrade from GET). Chain `.ws(handler)`.
    controller& ws(std::string_view path)
    {
        return route_for(path)[method_ws];
    }

    // Register a Server-Sent Events endpoint (takeover from GET). Chain `.sse(handler)`.
    controller& sse(std::string_view path)
    {
        return route_for(path)[method_sse];
    }

    void listen(std::string_view service_or_port = "http")
    {
        listen("0.0.0.0"sv, service_or_port, nullptr);
    }

    void listen(
        std::string_view host,
        std::string_view service_or_port,
        std::function<void()> on_bound = nullptr)
    {
        using namespace std::string_view_literals;
        m_stop.store(false);
        net::slog << net::notice("HTTP_SERVER_START") << "starting up at " << host << ":" << service_or_port
                  << std::pair{"addr"sv, host}
                  << std::pair{"port"sv, service_or_port}
                  << net::flush;
        try
        {
            auto endpoint = std::make_shared<net::acceptor>(host, service_or_port);
            {
                std::lock_guard lock{m_acceptor_mutex};
                m_acceptor = endpoint;
            }
            // Drop the shared slot when listen returns (normal stop or error),
            // so a late stop() cannot close a recycled acceptor.
            struct release_acceptor
            {
                server* self;
                ~release_acceptor()
                {
                    std::lock_guard lock{self->m_acceptor_mutex};
                    self->m_acceptor.reset();
                }
            } release{this};

            // Drain detached connection handlers on every listen() exit path
            // (stop, accept error, throw) before the caller destroys server-owned
            // state those handlers may still touch.
            struct wait_handlers
            {
                server* self;
                ~wait_handlers()
                {
                    self->wait_for_handlers();
                }
            } wait_exit{this};

            auto check_timeout = m_timeout.count() ? m_timeout : std::chrono::seconds{1};
            endpoint->timeout(std::chrono::milliseconds{check_timeout.count() * 1000});
            net::slog << net::notice("HTTP_SERVER_READY") << "started up at " << endpoint->host() << ":" << endpoint->service_or_port()
                      << std::pair{"addr", endpoint->host()}
                      << std::pair{"port", endpoint->service_or_port()}
                      << net::flush;
            if(on_bound)
                on_bound();

            while(not m_stop.load())
            {
                try
                {
                    using namespace std::string_view_literals;
                    net::slog << net::debug("HTTP_ACCEPT_WAIT")
                              << std::pair{"protocol"sv, "http"sv}
                              << "waiting for HTTP connections" << net::flush;
                    auto client = endpoint->accept();
                    // Track in-flight handlers so listen()/stop joiners do not
                    // destroy server-owned state (routes, MCP sessions) while a
                    // detached handle() is still running — that UAF showed up as
                    // flaky SIGSEGV/SIGABRT under parallel test --jobs.
                    // The same count is the connection cap. A full cap is answered
                    // here, on the accept thread, so it does not take another thread.
                    if(not reserve_connection())
                    {
                        try
                        {
                            auto& stream = std::get<0>(client);
                            const auto& peer = std::get<1>(client);
                            const auto& peer_port = std::get<2>(client);
                            net::slog << net::warning("HTTP_CONNECTION_LIMIT") << "connection cap reached from " << peer << ":" << peer_port
                                      << std::pair{"ip"sv, peer}
                                      << std::pair{"port", peer_port}
                                      << std::pair{"max_connections", static_cast<long long>(m_max_connections)}
                                      << std::pair{"status", status_service_unavailable}
                                      << net::flush;
                            // date() is auto and defined later, so the bytes live with the other writers.
                            write_service_unavailable(stream);
                        }
                        catch(const std::exception& e)
                        {
                            net::slog << net::warning("HTTP_CONNECTION_LIMIT") << "failed to write connection-cap response: " << e.what() << net::flush;
                        }
                        continue;
                    }
                    auto peer = std::get<1>(client);
                    if(not reserve_client(peer))
                    {
                        handler_finished();
                        try
                        {
                            auto& stream = std::get<0>(client);
                            net::slog << net::warning("HTTP_CLIENT_CONNECTION_LIMIT") << "per-client connection cap reached from " << peer
                                      << std::pair{"ip"sv, peer}
                                      << std::pair{"port", std::get<2>(client)}
                                      << std::pair{"max_connections_per_client", static_cast<long long>(m_max_connections_per_client)}
                                      << std::pair{"status", status_service_unavailable}
                                      << net::flush;
                            write_service_unavailable(stream);
                        }
                        catch(const std::exception& e)
                        {
                            net::slog << net::warning("HTTP_CLIENT_CONNECTION_LIMIT") << "failed to write per-client cap response: " << e.what() << net::flush;
                        }
                        continue;
                    }
                    try
                    {
                        std::thread{[client_data = std::move(client), peer, this]() mutable
                        {
                            // Register the stream so stop() can endpointstream::shutdown()
                            // and wake blocking keep-alive reads without touching fds.
                            // Unregister before the stream is destroyed.
                            auto& stream = std::get<0>(client_data);
                            register_client_stream(stream);
                            struct complete
                            {
                                server* self;
                                net::endpointstream* stream;
                                const std::string& peer;
                                ~complete()
                                {
                                    self->unregister_client_stream(*stream);
                                    self->release_client(peer);
                                    self->handler_finished();
                                }
                            } done{this, &stream, peer};
                            handle(client_data);
                        }}.detach();
                    }
                    catch(...)
                    {
                        release_client(peer);
                        handler_finished();
                        throw;
                    }
                }
                catch(const std::system_error& e)
                {
                    // stop() closes listen fds so poll/accept wakes with
                    // EBADF / "acceptor closed" (or EINTR racing close). Treat
                    // post-stop accept errors as a clean exit, not fatal.
                    if(m_stop.load()
                        or e.code().value() == net::posix::ebadf
                        or std::string_view{e.what()}.contains("acceptor closed"))
                    {
                        break;
                    }
                    if(std::string_view{e.what()}.contains("timeout"))
                    {
                        continue;
                    }
                    // FD/memory/thread pressure is transient: once handlers
                    // release sockets/threads, accept + spawn can succeed again.
                    // Rethrowing here used to permanently stop the server after
                    // a single EMFILE. EAGAIN also covers std::thread failing to
                    // start (errc::resource_unavailable_try_again) after accept
                    // already succeeded — same permanent-stop footgun as EMFILE.
                    const auto err = e.code().value();
                    if(err == net::posix::emfile
                       or err == net::posix::enfile
                       or err == net::posix::enobufs
                       or err == net::posix::enomem
                       or err == net::posix::econnaborted
                       or err == net::posix::eagain
                       or err == net::posix::ewouldblock)
                    {
                        net::slog << net::warning("HTTP_ACCEPT_TRANSIENT") << "transient accept failure, retrying: " << e.what()
                                  << std::pair{"errno", err}
                                  << net::flush;
                        std::this_thread::sleep_for(std::chrono::milliseconds{10});
                        continue;
                    }
                    net::slog << net::error("HTTP_ACCEPT_ERROR") << "failed to accept connection: " << e.what() << " (code: " << e.code() << ")"
                              << std::pair{"errno", e.code().value()}
                              << net::flush;
                    throw;
                }
                catch(const std::bad_alloc& e)
                {
                    // accept() can succeed then fail allocating endpointbuf /
                    // client strings under heap pressure. ENOMEM from the
                    // syscall is soft-retried above; bad_alloc must be too or
                    // memory pressure still kills listen permanently.
                    if(m_stop.load())
                        break;
                    net::slog << net::warning("HTTP_ACCEPT_TRANSIENT") << "transient accept allocation failure, retrying: " << e.what()
                              << net::flush;
                    std::this_thread::sleep_for(std::chrono::milliseconds{10});
                    continue;
                }
                catch(const std::exception& e)
                {
                    if(m_stop.load())
                        break;
                    net::slog << net::error("HTTP_ACCEPT_EXCEPTION") << "exception while accepting connection: " << e.what() << net::flush;
                    throw;
                }
            }
            net::slog << net::notice("HTTP_SERVER_STOP") << "server stopped" << net::flush;
        }
        catch(const std::system_error& e)
        {
            net::slog << net::error("HTTP_LISTEN_ERROR") << "failed to create acceptor on " << service_or_port << ": " << e.what() << " (code: " << e.code() << ")"
                      << std::pair{"port"sv, service_or_port}
                      << std::pair{"errno", e.code().value()}
                      << net::flush;
            throw;
        }
        catch(const std::exception& e)
        {
            net::slog << net::error("HTTP_LISTEN_EXCEPTION") << "exception during server startup on " << service_or_port << ": " << e.what()
                      << std::pair{"port"sv, service_or_port}
                      << net::flush;
            throw;
        }
    }


    const auto& timeout() const
    {
        return m_timeout;
    }

    server& timeout(const std::chrono::seconds& t)
    {
        m_timeout = t;
        return *this;
    }

    // Idle timeout for request bytes on an accepted connection. Applied in
    // handle() via endpointstream::read_timeout. Does not affect accept().
    // WebSocket and SSE clear it for the lifetime of the taken-over socket.
    std::chrono::milliseconds read_timeout() const
    {
        return m_read_timeout;
    }

    server& read_timeout(std::chrono::milliseconds t)
    {
        m_read_timeout = t;
        return *this;
    }

    // Deadline for one whole request head plus body, started by its first byte.
    // Expiry is 408, the same as an idle read timeout.
    std::chrono::milliseconds request_timeout() const
    {
        return m_request_timeout;
    }

    server& request_timeout(std::chrono::milliseconds t)
    {
        m_request_timeout = t;
        return *this;
    }

    // Longest stall writing to a client before the connection is dropped.
    // Applies to normal responses, WebSocket, and SSE.
    std::chrono::milliseconds write_timeout() const
    {
        return m_write_timeout;
    }

    server& write_timeout(std::chrono::milliseconds t)
    {
        m_write_timeout = t;
        return *this;
    }

    // Ping / frame limits for WebSocket sessions taken over from this server.
    const net::websocket::session_limits& websocket_limits() const
    {
        return m_websocket_limits;
    }

    server& websocket_limits(net::websocket::session_limits limits)
    {
        m_websocket_limits = limits;
        return *this;
    }

    // Cap Content-Length before allocating/reading the body. Middleware that
    // inspects body.size() cannot prevent the allocation — the check below
    // runs first. Default is default_max_request_body_size (1 MiB).
    std::size_t max_request_body_size() const
    {
        return m_max_request_body_size;
    }

    server& max_request_body_size(std::size_t bytes)
    {
        m_max_request_body_size = bytes;
        return *this;
    }

    // Cap request-line + header block bytes before parsing. Default is
    // default_max_request_head_size (16 KiB). Oversized heads get 431 and close.
    std::size_t max_request_head_size() const
    {
        return m_max_request_head_size;
    }

    server& max_request_head_size(std::size_t bytes)
    {
        m_max_request_head_size = bytes;
        return *this;
    }

    // X-Frame-Options: DENY on every response. Turn this off for HTML that is
    // embedded. A handler may then set its own X-Frame-Options.
    bool frame_options() const
    {
        return m_frame_options;
    }

    server& frame_options(bool enabled)
    {
        m_frame_options = enabled;
        return *this;
    }

    // In-flight accepted connections. Default is default_max_connections.
    // Zero disables the cap. Set this before listen().
    std::size_t max_connections() const
    {
        return m_max_connections;
    }

    server& max_connections(std::size_t n)
    {
        m_max_connections = n;
        return *this;
    }

    // In-flight WebSocket + SSE connections, counted inside max_connections.
    // Over the cap the upgrade or stream is refused with 503. Zero disables it.
    std::size_t max_streaming_connections() const
    {
        return m_max_streaming_connections;
    }

    server& max_streaming_connections(std::size_t n)
    {
        m_max_streaming_connections = n;
        return *this;
    }

    // In-flight connections from one peer address. Default is
    // default_max_connections_per_client (off). Set this before listen().
    std::size_t max_connections_per_client() const
    {
        return m_max_connections_per_client;
    }

    server& max_connections_per_client(std::size_t n)
    {
        m_max_connections_per_client = n;
        return *this;
    }

    // Product token in the Server header. Default is default_server_token ("net").
    // An empty token omits the header. CR, LF, and NUL are rejected.
    std::string_view server_token() const
    {
        return m_server_token;
    }

    server& server_token(std::string_view token)
    {
        if(header_value_has_ctl(token))
            throw std::invalid_argument{"server token contains a control character"};
        m_server_token.assign(token);
        return *this;
    }

    // Signal the listen loop to exit and close listen sockets so accept wait
    // wakes immediately (Docker SIGTERM / join). Thread-safe vs listen().
    // Also endpointstream::shutdown()s live clients so idle keep-alive handlers
    // unblock; listen() then waits until those handlers finish before return.
    void stop()
    {
        m_stop.store(true);
        std::shared_ptr<net::acceptor> acceptor;
        {
            std::lock_guard lock{m_acceptor_mutex};
            acceptor = m_acceptor;
        }
        if(acceptor)
            acceptor->close();
        shutdown_client_streams();
    }

    bool stopped() const
    {
        return m_stop.load();
    }

    // Port the listen socket is bound to (0 before listen / after stop). Useful
    // when listen(..., "0") asks the OS for an ephemeral port.
    std::uint16_t bound_port()
    {
        std::shared_ptr<net::acceptor> acceptor;
        {
            std::lock_guard lock{m_acceptor_mutex};
            acceptor = m_acceptor;
        }
        return acceptor ? acceptor->bound_port() : 0;
    }

private:

    // Reserve one handler slot. False when the cap is already full.
    // Zero max_connections does not cap.
    bool reserve_connection()
    {
        if(m_max_connections == 0)
        {
            m_active_handlers.fetch_add(1, std::memory_order_acq_rel);
            return true;
        }

        auto current = m_active_handlers.load(std::memory_order_acquire);
        while(current < m_max_connections)
        {
            if(m_active_handlers.compare_exchange_weak(
                   current,
                   current + 1,
                   std::memory_order_acq_rel,
                   std::memory_order_acquire))
                return true;
        }
        return false;
    }

    // Same shape as reserve_connection, for WebSocket and SSE takeovers.
    bool reserve_stream()
    {
        if(m_max_streaming_connections == 0)
        {
            m_active_streams.fetch_add(1, std::memory_order_acq_rel);
            return true;
        }

        auto current = m_active_streams.load(std::memory_order_acquire);
        while(current < m_max_streaming_connections)
        {
            if(m_active_streams.compare_exchange_weak(
                   current,
                   current + 1,
                   std::memory_order_acq_rel,
                   std::memory_order_acquire))
                return true;
        }
        return false;
    }

    void stream_finished()
    {
        m_active_streams.fetch_sub(1, std::memory_order_acq_rel);
    }

    struct stream_slot
    {
        server* self;
        ~stream_slot()
        {
            self->stream_finished();
        }
    };

    bool reserve_client(const std::string& peer)
    {
        if(m_max_connections_per_client == 0)
            return true;
        std::lock_guard lock{m_client_counts_mutex};
        auto& count = m_client_counts[peer];
        if(count >= m_max_connections_per_client)
            return false;
        ++count;
        return true;
    }

    // Looks the peer up even when the cap is off, so changing the cap while
    // connections are open cannot leave a stale count behind.
    void release_client(const std::string& peer)
    {
        std::lock_guard lock{m_client_counts_mutex};
        if(auto it = m_client_counts.find(peer); it != m_client_counts.end() and --it->second == 0)
            m_client_counts.erase(it);
    }

    void handler_finished()
    {
        const auto previous = m_active_handlers.fetch_sub(1, std::memory_order_acq_rel);
        if(previous == 1)
        {
            std::lock_guard lock{m_handlers_mutex};
            m_handlers_cv.notify_all();
        }
    }

    void wait_for_handlers()
    {
        std::unique_lock lock{m_handlers_mutex};
        m_handlers_cv.wait(lock, [this]
        {
            return m_active_handlers.load(std::memory_order_acquire) == 0;
        });
    }

    void register_client_stream(net::endpointstream& stream)
    {
        // Insert under the same mutex as shutdown_client_streams so a concurrent
        // stop() either sees this stream in m_clients or we observe m_stop here.
        // Without the late self-shutdown, accept → fetch_add → detach can race
        // stop()'s shutdown pass: the handler is counted in m_active_handlers but
        // not yet registered, so wait_for_handlers() blocks forever on an idle
        // read_request_head that nobody wakes.
        std::lock_guard lock{m_clients_mutex};
        m_clients.insert(&stream);
        if(m_stop.load())
            stream.shutdown();
    }

    void unregister_client_stream(net::endpointstream& stream)
    {
        std::lock_guard lock{m_clients_mutex};
        m_clients.erase(&stream);
    }

    // Wake blocking I/O via the stream abstraction (not raw fds). Streams stay
    // registered until handle() returns, so pointers are valid under this lock.
    void shutdown_client_streams()
    {
        std::lock_guard lock{m_clients_mutex};
        for(auto* stream : m_clients)
            stream->shutdown();
    }

    // Read through the terminating blank line. A short read returns the bytes
    // received so far (possibly empty). The caller uses read_timed_out() to
    // tell an idle timeout from a peer close. Throws when max_bytes is hit so
    // a hostile client cannot grow memory without bound via request-line or
    // header fields (body size is capped separately).
    //
    // Terminate on CRLF or LF blank lines. RFC 7230 §3.5 allows recipients to
    // recognize LF as a line terminator, and the pre-cap parser (operator>> /
    // getline + net::crlf) accepted LF-only requests. Requiring "\r\n\r\n" only
    // left a complete LF-only head waiting forever in blocking get() — one stuck
    // detached handler thread per such client.
    // Note: "\r\n\r\n" does not end with "\n\n", so both checks are required.
    //
    // The wait for the first byte is a keep-alive idle wait and only read_timeout
    // applies. That byte starts request_timeout, which handle() clears once the
    // body is in.
    static std::string read_request_head(
        net::endpointstream& stream,
        std::size_t max_bytes,
        std::chrono::milliseconds request_timeout)
    {
        auto head = ""s;
        head.reserve(std::min(max_bytes, std::size_t{256}));
        while(true)
        {
            if((head.size() >= 4 and head.ends_with("\r\n\r\n"))
               or (head.size() >= 2 and head.ends_with("\n\n")))
                return head;

            if(head.size() >= max_bytes)
                throw std::runtime_error{"request headers too large"};

            const auto ch = stream.get();
            if(not stream.good())
                return head;

            if(head.empty() and request_timeout.count() > 0)
                stream.read_deadline(std::chrono::steady_clock::now() + request_timeout);
            head.push_back(static_cast<char>(ch));
        }
    }

    auto date() const
    {
        // Prefer C++23 chrono formatting where it is stable.
        // clang-22 (macOS) is known to crash compiling chrono formatting via std::format/std::vformat in our modules setup.
        // Keep local dev stable while still enabling CI coverage on Linux.
#if defined(__APPLE__) and defined(__clang__) and (__clang_major__ >= 22)
        return utils::rfc1123_legacy(std::chrono::system_clock::now());
#else
        using namespace std::chrono;
        const auto tp = floor<seconds>(std::chrono::system_clock::now());
        return std::vformat("{:%a, %d %b %Y %H:%M:%S GMT}", std::make_format_args(tp));
#endif
    }

    // Custom response headers are appended after the server's own Content-Length /
    // Connection lines. Echoing request framing/hop-by-hop headers (a common "copy
    // headers to response" pattern) or allowing CR/LF/NUL in values yields duplicate
    // framing or response splitting — proxies that prefer the last CL desync from
    // the body.
    static bool is_unsafe_response_header(std::string_view name, std::string_view value)
    {
        auto lower = std::string{name};
        utils::ascii_to_lower(lower);
        // Framing + RFC 9110 hop-by-hop names (and legacy Keep-Alive / Proxy-Connection).
        if(lower == "content-length"sv or lower == "transfer-encoding"sv
           or lower == "connection"sv or lower == "keep-alive"sv
           or lower == "upgrade"sv or lower == "te"sv
           or lower == "trailer"sv or lower == "trailers"sv
           or lower == "proxy-connection"sv
           or lower == "proxy-authenticate"sv
           or lower == "proxy-authorization"sv)
            return true;

        const auto has_ctl = [](std::string_view s)
        {
            return std::ranges::any_of(s, [](char c)
            {
                return c == '\r' or c == '\n' or c == '\0';
            });
        };
        return has_ctl(name) or has_ctl(value);
    }

    static bool header_value_has_ctl(std::string_view s)
    {
        return std::ranges::any_of(s, [](char c)
        {
            return c == '\r' or c == '\n' or c == '\0';
        });
    }

    // Server-owned response headers. A later custom copy would duplicate or
    // override the default. Server is always owned. X-Frame-Options stays
    // available to the handler when the default DENY is turned off.
    bool is_server_owned_header(std::string_view name) const
    {
        auto lower = std::string{name};
        utils::ascii_to_lower(lower);
        if(lower == "server"sv
           or lower == "traceresponse"sv
           or lower == "x-content-type-options"sv
           or lower == "referrer-policy"sv
           or lower == "permissions-policy"sv)
            return true;
        return m_frame_options and lower == "x-frame-options"sv;
    }

    // "Server: <token>\r\n", or empty when the token is empty. traceresponse names
    // the span handling this request, when one is set.
    std::string server_header() const
    {
        auto line = std::string{};
        if(not m_server_token.empty())
            line = "Server: " + m_server_token + "\r\n";
        if(const auto trace = net::trace::current())
            line += "traceresponse: " + net::trace::format_traceparent(*trace) + "\r\n";
        return line;
    }

    void write_custom_response_headers(std::ostream& os, const headers& hdrs) const
    {
        for(const auto& [name, value] : hdrs)
        {
            if(is_unsafe_response_header(name, value) or is_server_owned_header(name))
                continue;
            os << name << ": " << value << net::crlf;
        }
    }

    // Expect is a comma-separated list. Only 100-continue is understood.
    enum class expect_kind { absent, continue_ok, unsupported };

    static expect_kind classify_expect(std::string_view field)
    {
        auto saw_continue = false;
        while(not field.empty())
        {
            const auto comma = field.find(',');
            const auto token = utils::trim(comma == std::string_view::npos ? field : field.substr(0, comma));
            field = comma == std::string_view::npos ? std::string_view{} : field.substr(comma + 1);
            if(token.empty())
                continue;
            auto lower = std::string{token};
            utils::ascii_to_lower(lower);
            if(lower == "100-continue"sv)
                saw_continue = true;
            else
                return expect_kind::unsupported;
        }
        return saw_continue ? expect_kind::continue_ok : expect_kind::absent;
    }

    void write_service_unavailable(net::endpointstream& stream) const
    {
        stream << "HTTP/1.1 " << status_service_unavailable << net::crlf
               << "Date: " << date() << net::crlf
               << server_header()
               << "X-Content-Type-Options: nosniff" << net::crlf
               << "Referrer-Policy: no-referrer" << net::crlf
               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
        if(m_frame_options)
        {
            stream << "X-Frame-Options: DENY" << net::crlf;
        }
        stream << "Content-Type: " << m_content_type << net::crlf
               << "Content-Length: 0" << net::crlf
               << "Retry-After: 1" << net::crlf
               << "Connection: close" << net::crlf
               << net::crlf << net::flush;
    }

    void write_request_timeout(net::endpointstream& stream)
    {
        // get() sets failbit on the shared iostream, which would drop this write.
        stream.clear();
        stream << "HTTP/1.1 " << status_request_timeout << net::crlf
               << "Date: " << date() << net::crlf
               << server_header()
               << "X-Content-Type-Options: nosniff" << net::crlf
               << "Referrer-Policy: no-referrer" << net::crlf
               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
        if(m_frame_options)
        {
            stream << "X-Frame-Options: DENY" << net::crlf;
        }
        stream << "Content-Type: " << m_content_type << net::crlf
               << "Content-Length: 0" << net::crlf
               << "Connection: close" << net::crlf
               << net::crlf << net::flush;
    }

    auto methods() const
    {
        auto tmp = ""s;
        for(const auto&  m : m_methods)
        {
            if(not tmp.empty()) tmp += ", ";
            tmp += m;
        }
        return tmp;
    }

    void handle(auto& client)
    {
        using namespace std::string_view_literals;
        using namespace std::chrono;
        auto& [stream, endpoint, port] = client;
        const auto conn_start = system_clock::now();
        net::slog << net::notice("HTTP_CONN_ACCEPT") << "accepted connection from " << endpoint << ":" << port
                  << std::pair{"ip"sv, endpoint}
                  << std::pair{"port", port}
                  << net::flush;
        // Idle gap between request bytes. Accept uses server::timeout instead.
        // Cleared again when a WebSocket or SSE handler takes the socket.
        stream.read_timeout(m_read_timeout);
        stream.write_timeout(m_write_timeout);

        try
        {
            while(stream)
            {
                static std::atomic<std::uint64_t> request_counter{0};
                const auto request_start = system_clock::now();

                std::string head;
                try
                {
                    stream.read_deadline(std::nullopt);
                    head = read_request_head(stream, m_max_request_head_size, m_request_timeout);
                }
                catch(const std::runtime_error& e)
                {
                    if(not std::string_view{e.what()}.contains("too large"sv))
                        throw;
                    const auto request_id = std::to_string(++request_counter);
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_REQUEST_HEAD_TOO_LARGE") << "request head exceeds max size from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"max_request_head_size", static_cast<long long>(m_max_request_head_size)}
                              << std::pair{"status", status_request_header_fields_too_large}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_request_header_fields_too_large << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                const auto head_complete = (head.size() >= 4 and head.ends_with("\r\n\r\n"sv))
                    or (head.size() >= 2 and head.ends_with("\n\n"sv));
                if(not head_complete)
                {
                    if(stream.read_timed_out())
                    {
                        const auto conn_duration = duration_cast<milliseconds>(system_clock::now() - conn_start).count();
                        if(head.empty())
                        {
                            net::slog << net::info("HTTP_READ_TIMEOUT") << "idle read timeout from " << endpoint << ":" << port
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"connection_duration_ms", conn_duration}
                                      << net::flush;
                        }
                        else
                        {
                            const auto request_id = std::to_string(++request_counter);
                            net::slog << net::warning("HTTP_READ_TIMEOUT") << "request head timed out from " << endpoint << ":" << port
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"status", status_request_timeout}
                                      << std::pair{"request_id", request_id}
                                      << std::pair{"connection_duration_ms", conn_duration}
                                      << net::flush;
                            write_request_timeout(stream);
                        }
                        break;
                    }

                    if(head.empty())
                    {
                        if(stream.eof())
                        {
                            const auto conn_duration = duration_cast<milliseconds>(system_clock::now() - conn_start).count();
                            net::slog << net::info("HTTP_CONN_CLOSED") << "connection closed by client " << endpoint << ":" << port
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"connection_duration_ms", conn_duration}
                                      << net::flush;
                        }
                        else
                        {
                            const auto conn_duration = duration_cast<milliseconds>(system_clock::now() - conn_start).count();
                            net::slog << net::warning("HTTP_STREAM_ERROR") << "stream error reading request from " << endpoint << ":" << port << " (eof: " << stream.eof() << ", fail: " << stream.fail() << ", bad: " << stream.bad() << ")"
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"eof", stream.eof()}
                                      << std::pair{"fail", stream.fail()}
                                      << std::pair{"bad", stream.bad()}
                                      << std::pair{"connection_duration_ms", conn_duration}
                                      << net::flush;
                        }
                    }
                    else
                    {
                        const auto conn_duration = duration_cast<milliseconds>(system_clock::now() - conn_start).count();
                        net::slog << net::info("HTTP_CONN_CLOSED") << "connection closed before the request head finished from " << endpoint << ":" << port
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"connection_duration_ms", conn_duration}
                                  << net::flush;
                    }
                    break;
                }

                const auto request_id = std::to_string(++request_counter);

                auto parse = std::istringstream{head};
                std::string method, uri, version;
                parse >> method >> uri >> version >> net::crlf;

                if(method.empty() or uri.empty() or version.empty())
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_BAD_REQUEST_LINE") << "malformed request line from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                headers hs{};
                try
                {
                    parse >> hs >> net::crlf;
                }
                catch(const std::exception& e)
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::error("HTTP_PARSE_HEADERS_ERROR") << "failed to parse headers from " << endpoint << ":" << port << ": " << e.what()
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                // One span for this request. A keep-alive connection's next request
                // gets its own: this scope ends with the iteration.
                const auto request_trace = net::trace::scope{net::trace::adopt(
                    hs.try_get("traceparent"sv).value_or(""sv),
                    hs.try_get("tracestate"sv).value_or(""sv))};
                (void)request_trace;

                net::slog << net::notice("HTTP_REQUEST") << "request \"" << method << ' ' << uri << ' ' << version << "\""
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << std::pair{"method", method}
                          << std::pair{"uri", std::string{uri}}
                          << std::pair{"version", version}
                          << std::pair{"request_id", request_id}
                          << net::flush;

                // HTTP/1.1 requires Host
                if(not hs.contains("host") or hs["host"].empty())
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_MISSING_HOST") << "missing Host header from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"method", method}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                // Body framing is Content-Length only. Ignoring Transfer-Encoding
                // (or accepting TE + CL) desynchronizes from proxies that prefer
                // chunked encoding — reject before reading any body bytes.
                if(hs.contains("transfer-encoding"))
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_TRANSFER_ENCODING_UNSUPPORTED") << "Transfer-Encoding not supported from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"method", method}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"transfer_encoding", hs["transfer-encoding"]}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                // WebSocket upgrade takes over the connection (not a normal HTTP response).
                if(method == method_get and net::websocket::is_websocket_upgrade(hs))
                {
                    const auto path_only = std::string{uri.substr(0, uri.find('?'))};
                    const route_entry* matched = nullptr;
                    for(const auto& route : m_router)
                    {
                        if(not route_matches(route, path_only))
                            continue;
                        if(route.methods.contains(method_ws) and route.methods.at(method_ws).has_websocket())
                        {
                            matched = &route;
                            break;
                        }
                    }

                    if(not matched)
                    {
                        stream << "HTTP/1.1 " << status_not_found << net::crlf
                               << "Date: " << date() << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: " << m_content_type << net::crlf
                               << "Content-Length: 0" << net::crlf
                               << "Connection: close" << net::crlf
                               << net::crlf << net::flush;
                        break;
                    }

                    if(not hs.contains("sec-websocket-key") or hs["sec-websocket-key"].empty())
                    {
                        stream << "HTTP/1.1 " << status_bad_request << net::crlf
                               << "Date: " << date() << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: " << m_content_type << net::crlf
                               << "Content-Length: 0" << net::crlf
                               << "Connection: close" << net::crlf
                               << net::crlf << net::flush;
                        break;
                    }

                    // Same optional gate as SSE. Absent by default so non-browser
                    // clients that send no Origin still upgrade. A browser-facing
                    // route installs a gate that rejects a missing or unlisted Origin.
                    const auto& ws_ctrl = matched->methods.at(method_ws);
                    const auto ws_req = request{.method = method, .target = uri, .peer = endpoint, .route = &matched->pattern};
                    if(ws_ctrl.has_gate())
                    {
                        if(auto denied = ws_ctrl.m_gate(ws_req, hs))
                        {
                            auto [st, body, custom_h] = std::move(*denied);
                            if(header_value_has_ctl(st))
                            {
                                st = status_internal_server_error;
                                body.clear();
                                custom_h.reset();
                            }
                            const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                            net::slog << net::warning("HTTP_WEBSOCKET_REJECTED") << "websocket upgrade rejected from " << endpoint << ":" << port
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"uri", std::string{uri}}
                                      << std::pair{"status", st}
                                      << std::pair{"request_id", request_id}
                                      << std::pair{"duration_ms", request_duration}
                                      << net::flush;
                            stream << "HTTP/1.1 " << st << net::crlf
                                   << "Date: " << date() << net::crlf
                                   << server_header()
                                   << "X-Content-Type-Options: nosniff" << net::crlf
                                   << "Referrer-Policy: no-referrer" << net::crlf
                                   << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                            if(m_frame_options)
                            {
                                stream << "X-Frame-Options: DENY" << net::crlf;
                            }
                            stream << "Content-Type: " << m_content_type << net::crlf
                                   << "Content-Length: " << body.size() << net::crlf
                                   << "Connection: close" << net::crlf;
                            if(custom_h.has_value())
                                write_custom_response_headers(stream, custom_h.value());
                            stream << net::crlf << body << net::flush;
                            break;
                        }
                    }

                    if(not reserve_stream())
                    {
                        net::slog << net::warning("HTTP_STREAM_LIMIT") << "streaming connection cap reached, websocket refused"
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"max_streaming_connections", static_cast<long long>(m_max_streaming_connections)}
                                  << std::pair{"status", status_service_unavailable}
                                  << std::pair{"request_id", request_id}
                                  << net::flush;
                        write_service_unavailable(stream);
                        break;
                    }
                    const auto ws_slot = stream_slot{this};

                    const auto accept = net::websocket::sec_websocket_accept(hs["sec-websocket-key"]);
                    net::slog << net::notice("HTTP_WEBSOCKET_UPGRADE") << "upgrading connection"
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"request_id", request_id}
                              << net::flush;

                    stream << "HTTP/1.1 " << status_switching_protocols << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Upgrade: websocket" << net::crlf
                           << "Connection: Upgrade" << net::crlf
                           << "Sec-WebSocket-Accept: " << accept << net::crlf
                           << net::crlf << net::flush;

                    const auto ws_handler = net::websocket::text_handler{
                        [&ws_ctrl, &ws_req](std::string_view message) { return ws_ctrl.m_ws_callback(ws_req, message); }};
                    // The session replaces the HTTP idle timeout with ping keep-alive,
                    // so a quiet but live peer stays and a vanished one is dropped.
                    net::websocket::run_text_session(stream, ws_handler, m_websocket_limits);
                    break;
                }

                // SSE takeover: GET matching an SSE route streams without Content-Length.
                if(method == method_get)
                {
                    const auto path_only = std::string{uri.substr(0, uri.find('?'))};
                    const route_entry* matched = nullptr;
                    for(const auto& route : m_router)
                    {
                        if(not route_matches(route, path_only))
                            continue;
                        if(route.methods.contains(method_sse) and route.methods.at(method_sse).has_sse())
                        {
                            matched = &route;
                            break;
                        }
                    }

                    if(matched)
                    {
                        const auto& sse_ctrl = matched->methods.at(method_sse);
                        const auto sse_req = request{.method = method, .target = uri, .peer = endpoint, .route = &matched->pattern};
                        if(sse_ctrl.has_gate())
                        {
                            if(auto denied = sse_ctrl.m_gate(sse_req, hs))
                            {
                                auto [st, body, custom_h] = std::move(*denied);
                                if(header_value_has_ctl(st))
                                {
                                    st = status_internal_server_error;
                                    body.clear();
                                    custom_h.reset();
                                }
                                stream << "HTTP/1.1 " << st << net::crlf
                                       << "Date: " << date() << net::crlf
                                       << server_header()
                                       << "X-Content-Type-Options: nosniff" << net::crlf
                                       << "Referrer-Policy: no-referrer" << net::crlf
                                       << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                                if(m_frame_options)
                                {
                                    stream << "X-Frame-Options: DENY" << net::crlf;
                                }
                                stream << "Content-Type: " << m_content_type << net::crlf
                                       << "Content-Length: " << body.size() << net::crlf
                                       << "Connection: close" << net::crlf;
                                // Same filter as normal responses (#50): gate deny
                                // must not emit framing/hop-by-hop names or CR/LF/NUL.
                                if(custom_h.has_value())
                                    write_custom_response_headers(stream, custom_h.value());
                                stream << net::crlf << body << net::flush;
                                break;
                            }
                        }

                        if(not reserve_stream())
                        {
                            net::slog << net::warning("HTTP_STREAM_LIMIT") << "streaming connection cap reached, SSE refused"
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"uri", std::string{uri}}
                                      << std::pair{"max_streaming_connections", static_cast<long long>(m_max_streaming_connections)}
                                      << std::pair{"status", status_service_unavailable}
                                      << std::pair{"request_id", request_id}
                                      << net::flush;
                            write_service_unavailable(stream);
                            break;
                        }
                        const auto sse_slot = stream_slot{this};

                        const auto sse_open = system_clock::now();
                        net::slog << net::notice("HTTP_SSE_OPEN") << "opening SSE stream"
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"request_id", request_id}
                                  << net::flush;

                        // CORS: browser EventSource preflight uses options() +
                        // cors_middleware. ACAO on the SSE response head is applied
                        // when the controller has a CORS origin predicate (same
                        // allowlist as cors_middleware; helpers live here to avoid
                        // a http_server ↔ middlewares import cycle).
                        // Reflect Origin only when the value is free of CR/LF/NUL —
                        // otherwise this bypasses write_custom_response_headers (#50)
                        // and default MCP `host:*` / `http://host:*` patterns still
                        // match after an embedded CR (response header injection).
                        stream << "HTTP/1.1 " << status_ok << net::crlf
                               << "Date: " << date() << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: text/event-stream" << net::crlf
                               << "Cache-Control: no-cache" << net::crlf
                               << "Connection: keep-alive" << net::crlf;
                        if(sse_ctrl.has_cors_origin() and hs.contains("origin"s))
                        {
                            const auto origin = hs["origin"s];
                            if(not is_unsafe_response_header("access-control-allow-origin"sv, origin)
                               and sse_ctrl.cors_origin()(origin))
                            {
                                stream << "Access-Control-Allow-Origin: " << origin << net::crlf
                                       << "Vary: Origin" << net::crlf
                                       << "Access-Control-Allow-Credentials: true" << net::crlf;
                            }
                        }
                        stream << net::crlf << net::flush;

                        // The HTTP idle timeout must not drop a quiet event stream.
                        // write_timeout stays, so a client that stops reading is dropped.
                        stream.read_timeout(std::chrono::milliseconds{0});
                        stream.read_deadline(std::nullopt);
                        auto session = ::http::sse::session{stream};
                        try
                        {
                            sse_ctrl.m_sse_callback(session, sse_req, hs);
                        }
                        catch(const std::exception& e)
                        {
                            net::slog << net::error("HTTP_SSE_HANDLER_EXCEPTION") << e.what()
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"uri", std::string{uri}}
                                      << std::pair{"request_id", request_id}
                                      << net::flush;
                        }
                        catch(...)
                        {
                            net::slog << net::error("HTTP_SSE_HANDLER_EXCEPTION") << "unknown exception in SSE handler"
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"uri", std::string{uri}}
                                      << std::pair{"request_id", request_id}
                                      << net::flush;
                        }

                        const auto sse_duration = duration_cast<milliseconds>(system_clock::now() - sse_open).count();
                        net::slog << net::notice("HTTP_SSE_CLOSE") << "closing SSE stream"
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", sse_duration}
                                  << std::pair{"bytes_out", static_cast<long long>(session.bytes_out())}
                                  << net::flush;
                        break;
                    }
                }

                auto close_connection = false;
                if(hs.contains("connection"))
                {
                    auto connection = hs["connection"];
                    utils::ascii_to_lower(connection);
                    close_connection = connection.contains("close"sv);
                }

                // Extract additional headers for logging
                auto user_agent = ""s;
                if(hs.contains("user-agent"))
                    user_agent = hs["user-agent"];

                auto content_type = ""s;
                if(hs.contains("content-type"))
                    content_type = hs["content-type"];

                auto accept = ""s;
                if(hs.contains("accept"))
                    accept = hs["accept"];

                // Log additional headers if present
                if(not user_agent.empty() or not content_type.empty() or not accept.empty())
                {
                    net::slog << net::debug("HTTP_REQUEST_HEADERS") << "request headers"
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"request_id", request_id}
                              << std::pair{"user_agent", user_agent}
                              << std::pair{"content_type", content_type}
                              << std::pair{"accept", accept}
                              << net::flush;
                }

                long long content_length = 0;
                auto content_length_ok = true;
                if(hs.contains("content-length"))
                {
                    try
                    {
                        content_length = utils::stoll(hs["content-length"]);
                        if(content_length < 0)
                            content_length_ok = false;
                    }
                    catch(const std::exception&)
                    {
                        content_length_ok = false;
                    }
                }

                if(not content_length_ok)
                {
                    net::slog << net::warning("HTTP_INVALID_CONTENT_LENGTH") << "invalid content-length from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"content_length_str", hs["content-length"]}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                // Reject before allocate/read — body_size_validation_middleware
                // only sees the body after it is fully in memory.
                if(static_cast<unsigned long long>(content_length) > m_max_request_body_size)
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_PAYLOAD_TOO_LARGE") << "content-length exceeds max request body size from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"content_length", content_length}
                              << std::pair{"max_request_body_size", static_cast<long long>(m_max_request_body_size)}
                              << std::pair{"status", status_payload_too_large}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_payload_too_large << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                if(hs.contains("expect"))
                {
                    const auto expect = classify_expect(hs["expect"]);
                    if(expect == expect_kind::unsupported)
                    {
                        const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                        net::slog << net::warning("HTTP_EXPECTATION_FAILED") << "unsupported Expect from " << endpoint << ":" << port
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"expect", hs["expect"]}
                                  << std::pair{"status", status_expectation_failed}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", request_duration}
                                  << net::flush;
                        stream << "HTTP/1.1 " << status_expectation_failed << net::crlf
                               << "Date: " << date() << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: " << m_content_type << net::crlf
                               << "Content-Length: 0" << net::crlf
                               << "Connection: close" << net::crlf
                               << net::crlf << net::flush;
                        break;
                    }
                    // Interim response before the body, only when the body will
                    // be read. A final 4xx above is the rejection instead of 100.
                    if(expect == expect_kind::continue_ok and content_length > 0)
                    {
                        stream << "HTTP/1.1 100 Continue" << net::crlf
                               << net::crlf << net::flush;
                    }
                }

                std::string body(static_cast<std::size_t>(content_length), ' ');
                auto body_complete = true;
                try
                {
                    for(auto& c : body)
                    {
                        auto ch = stream.get();
                        if(stream.eof() or stream.fail())
                        {
                            body_complete = false;
                            break;
                        }
                        c = static_cast<char>(ch);
                    }
                }
                catch(const std::exception& e)
                {
                    body_complete = false;
                    net::slog << net::error("HTTP_BODY_READ_ERROR") << "error reading body from " << endpoint << ":" << port << ": " << e.what()
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << net::flush;
                }

                if(not body_complete)
                {
                    if(stream.read_timed_out())
                    {
                        const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                        net::slog << net::warning("HTTP_READ_TIMEOUT") << "request body timed out from " << endpoint << ":" << port
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"expected_bytes", static_cast<long long>(content_length)}
                                  << std::pair{"status", status_request_timeout}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", request_duration}
                                  << net::flush;
                        write_request_timeout(stream);
                        break;
                    }

                    // get() sets failbit on the shared iostream; clear it so the 400 is written.
                    stream.clear();
                    net::slog << net::warning("HTTP_INCOMPLETE_BODY") << "incomplete body read from " << endpoint << ":" << port << " (expected " << content_length << " bytes)"
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"expected_bytes", static_cast<long long>(content_length)}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: " << date() << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0" << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }

                stream.read_deadline(std::nullopt);

                net::slog << net::debug("HTTP_REQUEST_BODY") << "request body \"" << body << "\""
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << std::pair{"body_size", static_cast<long long>(body.size())}
                          << net::flush;

                if(version != "HTTP/1.1")
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_UNSUPPORTED_VERSION") << "unsupported HTTP version \"" << version << "\" from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"method", method}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"version", version}
                              << std::pair{"status", 505}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    // Close + break: after drain-on-listen-exit, falling through to
                    // another keep-alive read leaves join(stop) blocked forever while
                    // the client still holds the socket open (websocket substring test).
                    stream << "HTTP/1.1 505 HTTP Version Not Supported" << net::crlf
                           << "Date: "         << date()                << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type        << net::crlf
                           << "Content-Length: 0"                       << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }
                else if(not m_methods.contains(method))
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::warning("HTTP_UNSUPPORTED_METHOD") << "unsupported HTTP method \"" << method << "\" for \"" << uri << "\" from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"method", method}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"status", status_bad_request}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_bad_request << net::crlf
                           << "Date: "         << date()                    << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type            << net::crlf
                           << "Content-Length: 0"                           << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }
                else if(uri == "/favicon.ico")
                {
                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                    net::slog << net::debug("HTTP_FAVICON_REQUEST") << "favicon request from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                              << std::pair{"port", port}
                              << std::pair{"method", method}
                              << std::pair{"uri", std::string{uri}}
                              << std::pair{"status", status_not_found}
                              << std::pair{"request_id", request_id}
                              << std::pair{"duration_ms", request_duration}
                              << net::flush;
                    stream << "HTTP/1.1 " << status_not_found << net::crlf
                           << "Date: "         << date()         << net::crlf
                           << server_header()
                           << "X-Content-Type-Options: nosniff" << net::crlf
                           << "Referrer-Policy: no-referrer" << net::crlf
                           << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                    if(m_frame_options)
                    {
                        stream << "X-Frame-Options: DENY" << net::crlf;
                    }
                    stream << "Content-Type: " << m_content_type << net::crlf
                           << "Content-Length: 0"                << net::crlf
                           << "Connection: close" << net::crlf
                           << net::crlf << net::flush;
                    break;
                }
                else
                {
                    std::string res_status, res_type, res_content;
                    std::optional<headers> custom_headers;
                    bool route_found = false;
                    bool method_allowed = false;

                    // Match the full request-target. Route regexes may include a
                    // query pattern; a match is also a guarantee to the handler
                    // that path (and query, when patterned) are well-formed.
                    // Path-only matching (626b26f) broke that contract.
                    for(const auto& route : m_router)
                        if(route_matches(route, uri))
                        {
                            const auto& [path, pattern, methods_map] = route;
                            route_found = true;
                            auto it = methods_map.find(method);
                            // HEAD / OPTIONS without a dedicated handler: reuse GET.
                            // cors_middleware short-circuits OPTIONS preflight before
                            // the inner GET callback runs.
                            if(it == methods_map.end()
                               and (method == method_head or method == method_options))
                                it = methods_map.find(method_get);

                            if(it != methods_map.end())
                            {
                                method_allowed = true;
                                try
                                {
                                    // Old-style handlers receive the URI only; expose method for metrics middleware.
                                    hs.set("x-http-method"s, method);
                                    const auto req = request{.method = method, .target = uri, .peer = endpoint, .route = &pattern};
                                    std::tie(res_status, res_content, res_type, custom_headers) = it->second.render(req, body, hs);
                                    if(not res_type.empty())
                                        break;
                                }
                                catch(const std::exception& e)
                                {
                                    const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                                    net::slog << net::error("HTTP_HANDLER_EXCEPTION") << "exception in handler for \"" << method << " " << uri << "\" (route: " << path << "): " << e.what()
                                              << std::pair{"ip"sv, endpoint}
                                              << std::pair{"port", port}
                                              << std::pair{"method", method}
                                              << std::pair{"uri", std::string{uri}}
                                              << std::pair{"route", path}
                                              << std::pair{"status", status_internal_server_error}
                                              << std::pair{"request_id", request_id}
                                              << std::pair{"duration_ms", request_duration}
                                              << net::flush;
                                    res_status = status_internal_server_error;
                                    res_content = "";
                                    res_type = m_content_type;
                                    custom_headers = std::nullopt;
                                    break;
                                }
                            }
                        }

                    // OPTIONS with no handler (and no GET fallback): 204. Prefer a
                    // cors-wrapped GET so preflight gets ACAO; bare POST-only paths
                    // get 204 without running application handlers.
                    if(method == method_options and not method_allowed and res_type.empty())
                    {
                        res_status = status_no_content;
                        res_content = "";
                        res_type = m_content_type;
                        custom_headers = std::nullopt;
                    }
                    // If route found but method not allowed, return 405 Method Not Allowed
                    else if(route_found and not method_allowed and res_type.empty())
                    {
                        const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                        net::slog << net::warning("HTTP_METHOD_NOT_ALLOWED") << "method not allowed for \"" << method << " " << uri << "\" from " << endpoint << ":" << port
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"method", method}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"status", status_method_not_allowed}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", request_duration}
                                  << net::flush;
                        res_status = status_method_not_allowed;
                        res_content = "";
                        res_type = m_content_type;
                        custom_headers = std::nullopt;
                    }

                    if(not res_type.empty())
                    {
                        // Same control-character rule as custom headers. A handler
                        // that copies request data into the status or content type
                        // would otherwise split the response. Stock 500 instead.
                        if(header_value_has_ctl(res_status) or header_value_has_ctl(res_type))
                        {
                            net::slog << net::warning("HTTP_UNSAFE_RESPONSE") << "status or content-type contained a control character"
                                      << std::pair{"ip"sv, endpoint}
                                      << std::pair{"port", port}
                                      << std::pair{"method", method}
                                      << std::pair{"uri", std::string{uri}}
                                      << std::pair{"status", status_internal_server_error}
                                      << std::pair{"request_id", request_id}
                                      << net::flush;
                            res_status = status_internal_server_error;
                            res_content.clear();
                            res_type = std::string{error_content_type};
                            custom_headers = std::nullopt;
                        }

                        // Extract status code from status string (e.g., "200 OK" -> 200)
                        auto status_code = 200ll;
                        try {
                            if(auto space_pos = res_status.find(' '); space_pos != std::string::npos) {
                                status_code = utils::stoll(res_status.substr(0, space_pos));
                            }
                        } catch(...) {}
                        
                        // Calculate request duration
                        const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                        
                        net::slog << net::info("HTTP_RESPONSE") << "response " << res_status
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"method", method}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"status", status_code}
                                  << std::pair{"content_length", static_cast<long long>(res_content.length())}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", request_duration}
                                  << net::flush;
                        
                        stream << "HTTP/1.1 " << res_status                                   << net::crlf
                               << "Date: " << date()                                          << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: " << res_type                                << net::crlf
                               << "Content-Length: " << res_content.length()                  << net::crlf
                               << "Connection: " << (close_connection ? "close"sv : "keep-alive"sv) << net::crlf;

                        if(custom_headers.has_value())
                            write_custom_response_headers(stream, custom_headers.value());

                        stream << "Cache-Control: private"                                    << net::crlf
                               << net::crlf
                               << (method != "HEAD" ? res_content : "") << net::flush;
                    }
                    else
                    {
                            // Calculate request duration for 404
                        const auto request_duration = duration_cast<milliseconds>(system_clock::now() - request_start).count();
                        
                        net::slog << net::warning("HTTP_ROUTE_NOT_FOUND") << "no route found for \"" << method << " " << uri << "\" from " << endpoint << ":" << port
                                  << std::pair{"ip"sv, endpoint}
                                  << std::pair{"port", port}
                                  << std::pair{"method", method}
                                  << std::pair{"uri", std::string{uri}}
                                  << std::pair{"status", status_not_found}
                                  << std::pair{"request_id", request_id}
                                  << std::pair{"duration_ms", request_duration}
                                  << net::flush;
                        stream << "HTTP/1.1 " << status_not_found << net::crlf
                               << "Date: " << date()                                          << net::crlf
                               << server_header()
                               << "X-Content-Type-Options: nosniff" << net::crlf
                               << "Referrer-Policy: no-referrer" << net::crlf
                               << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                        if(m_frame_options)
                        {
                            stream << "X-Frame-Options: DENY" << net::crlf;
                        }
                        stream << "Content-Type: " << m_content_type                          << net::crlf
                               << "Content-Length: 0"                                         << net::crlf
                               << "Connection: " << (close_connection ? "close"sv : "keep-alive"sv) << net::crlf
                               << "Cache-Control: private"                                    << net::crlf
                               << net::crlf << net::flush;
                    }
                }

                if(close_connection)
                    break;
            }
            const auto conn_duration = duration_cast<milliseconds>(system_clock::now() - conn_start).count();
            net::slog << net::info("HTTP_CONN_CLOSED") << "connection closed"
                              << std::pair{"ip"sv, endpoint}
                      << std::pair{"port", port}
                      << std::pair{"connection_duration_ms", conn_duration}
                      << net::flush;
        }
        catch(const std::system_error& e)
        {
            net::slog << net::error("HTTP_SYSTEM_ERROR") << "system error handling connection from " << endpoint << ":" << port << ": " << e.what() << " (code: " << e.code() << ")"
                              << std::pair{"ip"sv, endpoint}
                      << std::pair{"port", port}
                      << std::pair{"errno", e.code().value()}
                      << std::pair{"status", status_internal_server_error}
                      << net::flush;
            try
            {
                stream << "HTTP/1.1 " << status_internal_server_error << net::crlf
                       << "Date: " << date()                   << net::crlf
                       << server_header()
                       << "X-Content-Type-Options: nosniff" << net::crlf
                       << "Referrer-Policy: no-referrer" << net::crlf
                       << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                if(m_frame_options)
                {
                    stream << "X-Frame-Options: DENY" << net::crlf;
                }
                stream << "Content-Type: " << m_content_type   << net::crlf
                       << "Content-Length: 0"                  << net::crlf
                       << net::crlf << net::flush;
            }
            catch(const std::exception& write_error)
            {
                net::slog << net::error("HTTP_WRITE_ERROR") << "failed to write error response to " << endpoint << ":" << port << ": " << write_error.what()
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << net::flush;
            }
        }
        catch(const std::exception& e)
        {
            net::slog << net::error("HTTP_CONN_EXCEPTION") << "exception handling connection from " << endpoint << ":" << port << ": " << e.what()
                              << std::pair{"ip"sv, endpoint}
                      << std::pair{"port", port}
                      << std::pair{"status", status_internal_server_error}
                      << net::flush;
            try
            {
                stream << "HTTP/1.1 " << status_internal_server_error << net::crlf
                       << "Date: " << date()                   << net::crlf
                       << server_header()
                       << "X-Content-Type-Options: nosniff" << net::crlf
                       << "Referrer-Policy: no-referrer" << net::crlf
                       << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                if(m_frame_options)
                {
                    stream << "X-Frame-Options: DENY" << net::crlf;
                }
                stream << "Content-Type: " << m_content_type   << net::crlf
                       << "Content-Length: 0"                  << net::crlf
                       << net::crlf << net::flush;
            }
            catch(const std::exception& write_error)
            {
                net::slog << net::error("HTTP_WRITE_ERROR") << "failed to write error response to " << endpoint << ":" << port << ": " << write_error.what()
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << net::flush;
            }
        }
        catch(...)
        {
            net::slog << net::error("HTTP_UNKNOWN_EXCEPTION") << "unknown exception (non-standard exception type) handling connection from " << endpoint << ":" << port
                              << std::pair{"ip"sv, endpoint}
                      << std::pair{"port", port}
                      << std::pair{"status", status_internal_server_error}
                      << net::flush;
            try
            {
                stream << "HTTP/1.1 " << status_internal_server_error << net::crlf
                       << "Date: " << date()                   << net::crlf
                       << server_header()
                       << "X-Content-Type-Options: nosniff" << net::crlf
                       << "Referrer-Policy: no-referrer" << net::crlf
                       << "Permissions-Policy: camera=(), microphone=(), geolocation=()" << net::crlf;
                if(m_frame_options)
                {
                    stream << "X-Frame-Options: DENY" << net::crlf;
                }
                stream << "Content-Type: " << m_content_type   << net::crlf
                       << "Content-Length: 0"                  << net::crlf
                       << net::crlf << net::flush;
            }
            catch(const std::exception& write_error)
            {
                net::slog << net::error("HTTP_WRITE_ERROR") << "failed to write error response to " << endpoint << ":" << port << ": " << write_error.what()
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << net::flush;
            }
            catch(...)
            {
                net::slog << net::error("WRITE_ERROR") << "failed to write error response to " << endpoint << ":" << port << " (unknown exception in write)"
                          << std::pair{"ip"sv, endpoint}
                          << std::pair{"port", port}
                          << net::flush;
            }
        }
    }

    // Router: routes in registration order; the first matching route wins.
    // Node-based containers: get()/post()/... hand out controller& that must
    // survive later registrations. flat_map and vector relocate on insert.
    using path_type = std::string;           // Route path regex (e.g., "/api/users/[0-9]+")
    using method_type = std::string_view;    // HTTP method (e.g., "GET", "POST")

    using method_map_type = std::map<method_type, controller>;

    struct route_entry
    {
        path_type path;
        std::regex pattern;
        method_map_type methods;
    };

    using router_type = std::list<route_entry>;

    // Compile the pattern once, on first registration. An invalid regex throws
    // std::regex_error here instead of on every matching request.
    method_map_type& route_for(std::string_view path)
    {
        auto it = std::ranges::find(m_router, path, &route_entry::path);
        if(it == m_router.end())
            it = m_router.insert(m_router.end(), route_entry{std::string{path}, std::regex{path.begin(), path.end()}, {}});
        return it->methods;
    }

    // libc++ throws regex_error (error_complexity) instead of backtracking without
    // bound, e.g. "/(\w+/?)+" on a near-miss target. Treat that as no match so
    // later routes are still tried and an unmatched target gets 404, not 500.
    static bool route_matches(const route_entry& route, std::string_view target)
    {
        try
        {
            return std::regex_match(target.begin(), target.end(), route.pattern);
        }
        catch(const std::regex_error& e)
        {
            net::slog << net::warning("HTTP_ROUTE_REGEX_ERROR") << "route pattern \"" << route.path << "\" gave up matching: " << e.what()
                      << std::pair{"route", route.path}
                      << std::pair{"target_length", target.size()}
                      << net::flush;
            return false;
        }
    }

    router_type m_router = {};
    std::string m_content_type{error_content_type};
    std::flat_set<method_type> m_methods = {method_head, method_options};
    std::chrono::seconds m_timeout = std::chrono::seconds{0};
    std::chrono::milliseconds m_read_timeout = default_read_timeout;
    std::chrono::milliseconds m_request_timeout = default_request_timeout;
    std::chrono::milliseconds m_write_timeout = default_write_timeout;
    net::websocket::session_limits m_websocket_limits{};
    std::size_t m_max_request_body_size = default_max_request_body_size;
    std::size_t m_max_request_head_size = default_max_request_head_size;
    bool m_frame_options = true;
    std::string m_server_token{default_server_token};
    std::size_t m_max_connections = default_max_connections;
    std::size_t m_max_streaming_connections = default_max_streaming_connections;
    std::size_t m_max_connections_per_client = default_max_connections_per_client;
    std::atomic<bool> m_stop{false};
    std::atomic<std::size_t> m_active_handlers{0};
    std::atomic<std::size_t> m_active_streams{0};
    std::mutex m_client_counts_mutex;
    std::flat_map<std::string, std::size_t> m_client_counts;
    std::mutex m_handlers_mutex;
    std::condition_variable m_handlers_cv;
    std::mutex m_clients_mutex;
    std::flat_set<net::endpointstream*> m_clients;
    std::mutex m_acceptor_mutex;
    std::shared_ptr<net::acceptor> m_acceptor;
};

} // namespace http

