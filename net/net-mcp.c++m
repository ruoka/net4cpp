export module net:mcp;
import :http_server;
import :sse;
import :uuid;
import :utils;
import std;

export namespace http::mcp
{

using namespace std::string_literals;
using namespace std::string_view_literals;

inline constexpr auto default_protocol_version = "2024-11-05"sv;

// Extract `key` from a request-target query string (`path?a=1&b=2`).
inline std::optional<std::string> query_param(std::string_view request_target, std::string_view key)
{
    const auto qpos = request_target.find('?');
    if(qpos == std::string_view::npos)
        return std::nullopt;

    auto query = request_target.substr(qpos + 1);
    while(not query.empty())
    {
        const auto amp = query.find('&');
        const auto part = amp == std::string_view::npos ? query : query.substr(0, amp);
        const auto eq = part.find('=');
        const auto name = eq == std::string_view::npos ? part : part.substr(0, eq);
        if(name == key)
        {
            if(eq == std::string_view::npos)
                return ""s;
            return std::string{part.substr(eq + 1)};
        }
        if(amp == std::string_view::npos)
            break;
        query.remove_prefix(amp + 1);
    }
    return std::nullopt;
}

// MCP Python SDK uses uuid4().hex (32 lowercase hex chars, no dashes).
inline std::string make_session_id()
{
    auto id = net::generate_uuid_v4();
    id.erase(std::remove(id.begin(), id.end(), '-'), id.end());
    return id;
}

// --- Minimal JSON helpers (MCP v1 surface only; no full JSON library) ---

inline std::string json_escape(std::string_view text)
{
    auto out = ""s;
    out.reserve(text.size() + 8);
    for(const auto ch : text)
    {
        switch(ch)
        {
            case '"': out += "\\\""; break;
            case '\\': out += "\\\\"; break;
            case '\b': out += "\\b"; break;
            case '\f': out += "\\f"; break;
            case '\n': out += "\\n"; break;
            case '\r': out += "\\r"; break;
            case '\t': out += "\\t"; break;
            default:
                if(static_cast<unsigned char>(ch) < 0x20)
                {
                    constexpr auto hex = "0123456789abcdef";
                    out += "\\u00";
                    out.push_back(hex[(static_cast<unsigned char>(ch) >> 4) & 0xF]);
                    out.push_back(hex[static_cast<unsigned char>(ch) & 0xF]);
                }
                else
                    out.push_back(ch);
                break;
        }
    }
    return out;
}

inline std::string json_quote(std::string_view text)
{
    return "\""s + json_escape(text) + "\"";
}

namespace detail
{

inline std::string_view trim_ws(std::string_view s)
{
    while(not s.empty() and (s.front() == ' ' or s.front() == '\t' or s.front() == '\n' or s.front() == '\r'))
        s.remove_prefix(1);
    while(not s.empty() and (s.back() == ' ' or s.back() == '\t' or s.back() == '\n' or s.back() == '\r'))
        s.remove_suffix(1);
    return s;
}

// Locate `"key"` as a top-level object member only (depth == 1). Nested
// objects must not contribute keys: for tools/call, `arguments.name` must
// not shadow `params.name` when clients serialize `arguments` before `name`
// (alphabetical / BTreeMap key order).
inline std::optional<std::size_t> find_key(std::string_view json, std::string_view key)
{
    const auto needle = "\""s + std::string{key} + "\"";
    auto depth = 0;
    auto in_string = false;
    auto escape = false;
    for(std::size_t i = 0; i < json.size(); ++i)
    {
        const auto ch = json[i];
        if(in_string)
        {
            if(escape)
                escape = false;
            else if(ch == '\\')
                escape = true;
            else if(ch == '"')
                in_string = false;
            continue;
        }
        if(ch == '"')
        {
            if(depth == 1 and json.substr(i).starts_with(needle))
            {
                auto after = trim_ws(json.substr(i + needle.size()));
                if(not after.empty() and after.front() == ':')
                    return i;
            }
            in_string = true;
            continue;
        }
        if(ch == '{' or ch == '[')
            ++depth;
        else if(ch == '}' or ch == ']')
        {
            if(depth > 0)
                --depth;
        }
    }
    return std::nullopt;
}

inline std::optional<std::string_view> json_string_field(std::string_view json, std::string_view key)
{
    const auto key_pos = find_key(json, key);
    if(not key_pos)
        return std::nullopt;
    auto rest = json.substr(*key_pos + key.size() + 2);
    rest = trim_ws(rest);
    if(rest.empty() or rest.front() != ':')
        return std::nullopt;
    rest.remove_prefix(1);
    rest = trim_ws(rest);
    if(rest.empty() or rest.front() != '"')
        return std::nullopt;
    rest.remove_prefix(1);
    auto out_start = rest;
    auto i = std::size_t{0};
    while(i < rest.size())
    {
        if(rest[i] == '\\')
        {
            i += (i + 1 < rest.size()) ? 2 : 1;
            continue;
        }
        if(rest[i] == '"')
            return out_start.substr(0, i);
        ++i;
    }
    return std::nullopt;
}

// Raw JSON value for `id` (number, string, or null) — copied without surrounding spaces.
inline std::optional<std::string> json_id_field(std::string_view json)
{
    const auto key_pos = find_key(json, "id"sv);
    if(not key_pos)
        return std::nullopt;
    auto rest = trim_ws(json.substr(*key_pos + 4));
    if(rest.empty() or rest.front() != ':')
        return std::nullopt;
    rest = trim_ws(rest.substr(1));
    if(rest.empty())
        return std::nullopt;
    if(rest.starts_with("null"sv))
        return "null"s;
    if(rest.front() == '"')
    {
        // Keep the original quoted token (including escapes) from the request.
        auto i = std::size_t{1};
        auto escape = false;
        while(i < rest.size())
        {
            if(escape)
                escape = false;
            else if(rest[i] == '\\')
                escape = true;
            else if(rest[i] == '"')
                return std::string{rest.substr(0, i + 1)};
            ++i;
        }
        return std::nullopt;
    }
    auto i = std::size_t{0};
    while(i < rest.size() and rest[i] != ',' and rest[i] != '}' and rest[i] != ' '
          and rest[i] != '\n' and rest[i] != '\r' and rest[i] != '\t')
        ++i;
    return std::string{rest.substr(0, i)};
}

inline std::optional<std::string_view> json_object_field(std::string_view json, std::string_view key)
{
    const auto key_pos = find_key(json, key);
    if(not key_pos)
        return std::nullopt;
    auto rest = trim_ws(json.substr(*key_pos + key.size() + 2));
    if(rest.empty() or rest.front() != ':')
        return std::nullopt;
    rest = trim_ws(rest.substr(1));
    if(rest.empty() or rest.front() != '{')
        return std::nullopt;
    auto depth = 0;
    auto in_string = false;
    auto escape = false;
    for(std::size_t i = 0; i < rest.size(); ++i)
    {
        const auto ch = rest[i];
        if(in_string)
        {
            if(escape)
                escape = false;
            else if(ch == '\\')
                escape = true;
            else if(ch == '"')
                in_string = false;
            continue;
        }
        if(ch == '"')
        {
            in_string = true;
            continue;
        }
        if(ch == '{')
            ++depth;
        else if(ch == '}')
        {
            --depth;
            if(depth == 0)
                return rest.substr(0, i + 1);
        }
    }
    return std::nullopt;
}

} // namespace detail

// Host/Origin pattern match: exact, or `host:*` / `http://host:*` (port wildcard).
inline bool match_allow_pattern(std::string_view value, std::string_view pattern)
{
    if(pattern.ends_with(":*"sv))
    {
        const auto prefix = pattern.substr(0, pattern.size() - 2);
        if(value == prefix)
            return true;
        if(value.starts_with(prefix) and value.size() > prefix.size() and value[prefix.size()] == ':')
            return true;
        return false;
    }
    return value == pattern;
}

inline bool value_allowed(std::string_view value, std::span<const std::string> patterns)
{
    for(const auto& p : patterns)
    {
        if(match_allow_pattern(value, p))
            return true;
    }
    return false;
}

inline std::vector<std::string> default_allowed_hosts()
{
    return {"127.0.0.1:*"s, "localhost:*"s, "[::1]:*"s};
}

inline std::vector<std::string> default_allowed_origins()
{
    return {
        "http://127.0.0.1:*"s,
        "http://localhost:*"s,
        "http://[::1]:*"s,
    };
}

struct tool_spec
{
    std::string name;
    std::string description;
    // Opaque JSON object; default empty object schema.
    std::string input_schema = R"({"type":"object","properties":{}})"s;
};

struct tool_result
{
    std::string text;
    bool is_error = false;
};

using list_tools_fn = std::function<std::vector<tool_spec>()>;
using call_tool_fn = std::function<tool_result(std::string_view name, std::string_view arguments_json)>;

struct server_info
{
    std::string name = "net-mcp"s;
    std::string version = "1.0.0"s;
    std::string protocol_version = std::string{default_protocol_version};
};

// JSON-RPC dispatch (unit-testable). Returns nullopt for notifications / no reply.
inline std::optional<std::string> handle_json_rpc(
    std::string_view message,
    const server_info& info,
    const list_tools_fn& list_tools,
    const call_tool_fn& call_tool)
{
    using detail::json_id_field;
    using detail::json_object_field;
    using detail::json_string_field;

    const auto method = json_string_field(message, "method"sv);
    if(not method)
    {
        if(auto id = json_id_field(message))
            return R"({"jsonrpc":"2.0","id":)"s + *id
                + R"(,"error":{"code":-32600,"message":"Invalid Request"}})"s;
        return std::nullopt;
    }

    const auto id = json_id_field(message);

    if(*method == "notifications/initialized"sv or method->starts_with("notifications/"sv))
        return std::nullopt;

    if(not id)
        return std::nullopt;

    auto result_msg = [&](std::string_view result_json)
    {
        return R"({"jsonrpc":"2.0","id":)"s + *id + R"(,"result":)"s + std::string{result_json} + "}"s;
    };
    auto error_msg = [&](int code, std::string_view msg)
    {
        return R"({"jsonrpc":"2.0","id":)"s + *id + R"(,"error":{"code":)"s
            + std::to_string(code) + R"(,"message":)"s + json_quote(msg) + "}}"s;
    };

    if(*method == "initialize"sv)
    {
        auto result = R"({"protocolVersion":)"s + json_quote(info.protocol_version)
            + R"(,"capabilities":{"tools":{}},"serverInfo":{"name":)"s
            + json_quote(info.name) + R"(,"version":)"s + json_quote(info.version) + "}}"s;
        return result_msg(result);
    }

    if(*method == "ping"sv)
        return result_msg("{}"sv);

    if(*method == "tools/list"sv)
    {
        auto tools_json = "["s;
        if(list_tools)
        {
            auto first = true;
            for(const auto& tool : list_tools())
            {
                if(not first)
                    tools_json.push_back(',');
                first = false;
                tools_json += R"({"name":)"s + json_quote(tool.name)
                    + R"(,"description":)"s + json_quote(tool.description)
                    + R"(,"inputSchema":)"s + tool.input_schema + "}"s;
            }
        }
        tools_json.push_back(']');
        return result_msg(R"({"tools":)"s + tools_json + "}"s);
    }

    if(*method == "tools/call"sv)
    {
        const auto params = json_object_field(message, "params"sv).value_or("{}"sv);
        const auto name = json_string_field(params, "name"sv);
        if(not name)
            return error_msg(-32602, "Missing tool name"sv);

        if(list_tools)
        {
            const auto tools = list_tools();
            const auto known = std::ranges::any_of(tools, [&](const tool_spec& t) {
                return t.name == *name;
            });
            if(not known)
                return error_msg(-32601, "Unknown tool: "s + std::string{*name});
        }

        const auto arguments = json_object_field(params, "arguments"sv).value_or("{}"sv);
        if(not call_tool)
            return error_msg(-32601, "Unknown tool: "s + std::string{*name});
        try
        {
            const auto result = call_tool(*name, arguments);
            auto body = R"({"content":[{"type":"text","text":)"s + json_quote(result.text) + "}]"s;
            if(result.is_error)
                body += R"(,"isError":true)"s;
            body.push_back('}');
            return result_msg(body);
        }
        catch(const std::exception& e)
        {
            auto body = R"({"content":[{"type":"text","text":)"s
                + json_quote("error: "s + e.what()) + R"(}],"isError":true})"s;
            return result_msg(body);
        }
    }

    return error_msg(-32601, "Method not found: "s + std::string{*method});
}

namespace detail
{

struct session_state
{
    explicit session_state(std::string id)
        : id{std::move(id)}
    {
    }

    std::string id;
    std::mutex mutex;
    std::condition_variable cv;
    std::deque<std::string> inbound;
    bool closed = false;
};

} // namespace detail

// Per-connection MCP SSE session. Lives on the SSE thread; POSTs enqueue here.
class session
{
public:

    session(std::shared_ptr<detail::session_state> state, sse::session& stream) noexcept
        : m_state{std::move(state)}
        , m_stream{stream}
    {
    }

    [[nodiscard]] std::string_view id() const noexcept
    {
        return m_state->id;
    }

    bool send_message(std::string_view json)
    {
        return m_stream.send_event("message"sv, json);
    }

    bool send_comment(std::string_view text = {})
    {
        return m_stream.send_comment(text);
    }

    [[nodiscard]] bool closed() const
    {
        if(m_stream.closed())
            return true;
        std::lock_guard lock{m_state->mutex};
        return m_state->closed;
    }

    std::optional<std::string> recv(std::chrono::milliseconds timeout = std::chrono::milliseconds{0})
    {
        std::unique_lock lock{m_state->mutex};
        auto ready = [this]
        {
            return m_state->closed or not m_state->inbound.empty() or m_stream.closed();
        };

        if(timeout.count() <= 0)
            m_state->cv.wait(lock, ready);
        else if(not m_state->cv.wait_for(lock, timeout, ready))
            return std::nullopt;

        if(m_state->inbound.empty())
            return std::nullopt;

        auto msg = std::move(m_state->inbound.front());
        m_state->inbound.pop_front();
        return msg;
    }

private:

    std::shared_ptr<detail::session_state> m_state;
    sse::session& m_stream;
};

using session_handler = std::function<void(session&)>;
using request_gate = std::function<std::optional<response_with_headers>(request_view, headers&)>;

// Legacy MCP HTTP+SSE transport (session layer).
class sse_transport
{
public:

    explicit sse_transport(std::string messages_path = "/messages/")
        : m_messages_path{normalize_messages_path(std::move(messages_path))}
    {
    }

    [[nodiscard]] std::string_view messages_path() const noexcept
    {
        return m_messages_path;
    }

    void attach(
        http::server& server,
        std::string_view sse_path,
        session_handler on_session,
        request_gate gate = {},
        std::function<bool(std::string_view)> cors_origin = {})
    {
        auto post_pattern = m_messages_path;
        if(post_pattern.size() > 1 and post_pattern.back() == '/')
            post_pattern.pop_back();
        post_pattern += "/?(\\?.*)?"s;

        auto& sse_ctrl = server.sse(sse_path);
        if(gate)
            sse_ctrl.gate(gate);
        if(cors_origin)
            sse_ctrl.cors(std::move(cors_origin));

        sse_ctrl.sse(
            [this, on_session = std::move(on_session)](sse::session& stream, request_view, headers&)
            {
                const auto id = make_session_id();
                auto state = std::make_shared<detail::session_state>(id);
                {
                    std::lock_guard lock{m_mutex};
                    m_sessions[id] = state;
                }

                const auto endpoint = m_messages_path + "?session_id="s + id;
                if(not stream.send_event("endpoint"sv, endpoint))
                {
                    erase_session(id, state);
                    return;
                }

                auto sess = session{state, stream};
                try
                {
                    on_session(sess);
                }
                catch(...)
                {
                    erase_session(id, state);
                    throw;
                }
                erase_session(id, state);
            });

        server.post(post_pattern).response(
            "text/plain"sv,
            [this, gate](request_view req, body_view body, headers& hdr) -> response_with_headers
            {
                if(gate)
                {
                    if(auto denied = gate(req, hdr))
                        return *denied;
                }

                if(hdr.contains("content-type"s))
                {
                    auto ct = hdr["content-type"s];
                    utils::ascii_to_lower(ct);
                    if(not ct.starts_with("application/json"sv))
                        return make_error_response(status_bad_request, "Content-Type must be application/json"sv);
                }

                const auto sid = query_param(req, "session_id"sv);
                if(not sid.has_value() or sid->empty())
                    return make_error_response(status_bad_request, "session_id is required"sv);

                std::shared_ptr<detail::session_state> state;
                {
                    std::lock_guard lock{m_mutex};
                    const auto it = m_sessions.find(*sid);
                    if(it == m_sessions.end())
                        return make_error_response(status_not_found, "Could not find session"sv);
                    state = it->second;
                }

                {
                    std::lock_guard lock{state->mutex};
                    if(state->closed)
                        return make_error_response(status_not_found, "Could not find session"sv);
                    state->inbound.emplace_back(body);
                }
                state->cv.notify_one();
                return make_response(status_accepted, "Accepted"s);
            });
    }

    [[nodiscard]] std::size_t active_sessions() const
    {
        std::lock_guard lock{m_mutex};
        return m_sessions.size();
    }

private:

    static std::string normalize_messages_path(std::string path)
    {
        if(path.empty() or path.front() != '/')
            path.insert(path.begin(), '/');
        if(path.back() != '/')
            path.push_back('/');
        return path;
    }

    void erase_session(const std::string& id, const std::shared_ptr<detail::session_state>& state)
    {
        {
            std::lock_guard lock{state->mutex};
            state->closed = true;
            state->inbound.clear();
        }
        state->cv.notify_all();
        std::lock_guard lock{m_mutex};
        m_sessions.erase(id);
    }

    std::string m_messages_path;
    mutable std::mutex m_mutex;
    std::flat_map<std::string, std::shared_ptr<detail::session_state>> m_sessions;
};

// MCP protocol server (M5): JSON-RPC loop + DNS-rebinding Host/Origin defaults.
class server
{
public:

    explicit server(std::string messages_path = "/messages/")
        : m_transport{std::move(messages_path)}
    {
    }

    server& info(server_info info)
    {
        m_info = std::move(info);
        return *this;
    }

    server& list_tools(list_tools_fn fn)
    {
        m_list_tools = std::move(fn);
        return *this;
    }

    server& call_tool(call_tool_fn fn)
    {
        m_call_tool = std::move(fn);
        return *this;
    }

    server& allowed_hosts(std::vector<std::string> hosts)
    {
        m_allowed_hosts = std::move(hosts);
        return *this;
    }

    server& allowed_origins(std::vector<std::string> origins)
    {
        m_allowed_origins = std::move(origins);
        return *this;
    }

    server& dns_rebinding_protection(bool enabled)
    {
        m_dns_rebinding_protection = enabled;
        return *this;
    }

    // Register SSE + POST on `http`. `*this` must outlive listen/stop.
    void attach(http::server& http, std::string_view sse_path = "/sse")
    {
        if(m_dns_rebinding_protection)
        {
            if(m_allowed_hosts.empty())
                m_allowed_hosts = default_allowed_hosts();
            if(m_allowed_origins.empty())
                m_allowed_origins = default_allowed_origins();
        }

        auto gate = [this](request_view, headers& hdr) -> std::optional<response_with_headers>
        {
            if(not m_dns_rebinding_protection)
                return std::nullopt;

            if(not hdr.contains("host"s) or not value_allowed(hdr["host"s], m_allowed_hosts))
                return make_error_response(status_forbidden, "Invalid Host header"sv);

            // Origin is optional (non-browser clients); when present it must match.
            if(hdr.contains("origin"s) and not value_allowed(hdr["origin"s], m_allowed_origins))
                return make_error_response(status_forbidden, "Invalid Origin header"sv);

            return std::nullopt;
        };

        auto cors = std::function<bool(std::string_view)>{};
        if(m_dns_rebinding_protection)
        {
            cors = [this](std::string_view origin)
            {
                return value_allowed(origin, m_allowed_origins);
            };
        }

        m_transport.attach(
            http,
            sse_path,
            [this](session& sess)
            {
                run_session(sess);
            },
            gate,
            cors);
    }

    [[nodiscard]] sse_transport& transport() noexcept
    {
        return m_transport;
    }

private:

    void run_session(session& sess)
    {
        // recv(0) waits forever on the inbound CV and is not woken by a TCP
        // half-close. Without a periodic write probe, every client disconnect
        // leaks the handler thread and leaves the session_id in m_sessions
        // until an unrelated POST happens to arrive.
        constexpr auto heartbeat = std::chrono::seconds{1};
        while(not sess.closed())
        {
            auto msg = sess.recv(heartbeat);
            if(not msg)
            {
                if(not sess.send_comment())
                    break;
                continue;
            }
            if(auto reply = handle_json_rpc(*msg, m_info, m_list_tools, m_call_tool))
            {
                if(not sess.send_message(*reply))
                    break;
            }
        }
    }

    sse_transport m_transport;
    server_info m_info{};
    list_tools_fn m_list_tools;
    call_tool_fn m_call_tool;
    std::vector<std::string> m_allowed_hosts;
    std::vector<std::string> m_allowed_origins;
    bool m_dns_rebinding_protection = true;
};

} // namespace http::mcp
