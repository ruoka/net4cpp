export module net:structured_log_stream;
import std;
import :posix;

using namespace std::string_literals;

export namespace net::syslog {

// Public API enums - used by external code (yardb, yarproxy, etc.)
enum class facility : int
{
    user   = 1,
    local0 = 16,
    local1 = 17,
    local2 = 18,
    local3 = 19,
    local4 = 20,
    local5 = 21,
    local6 = 22,
    local7 = 23
};

enum class severity : int
{
     emergency = 0,
     alert     = 1,
     critical  = 2,
     error     = 3,
     warning   = 4,
     notice    = 5,
     info      = 6,
     debug     = 7
};

} // namespace net::syslog

namespace detail {
    // Implementation details (not exported - accessible to tests within the module)
    std::string format_timestamp(std::chrono::system_clock::time_point tp)
    {
        using namespace std::chrono;
        const auto midnight = floor<days>(tp);
        const auto date = year_month_day{midnight};
        const auto time = hh_mm_ss{tp - midnight};
        const auto ms = duration_cast<milliseconds>(time.subseconds()).count();

        return std::format(
            "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z",
            static_cast<int>(date.year()),
            static_cast<unsigned>(date.month()),
            static_cast<unsigned>(date.day()),
            static_cast<int>(time.hours().count()),
            static_cast<int>(time.minutes().count()),
            static_cast<int>(time.seconds().count()),
            static_cast<int>(ms));
    }

    // Internal type aliases for structured logging (not exported - accessible to tests within the module)
    using field_name_type = std::string;  // Structured log field name (e.g., "user_id", "ip", "file")

    // Support multiple integer types to avoid casts
    // Note: std::size_t may alias unsigned long or unsigned long long, so we handle it via template conversion
    using value = std::variant<
    std::nullptr_t,
    bool,
    int,
    unsigned int,
    long,
    unsigned long,
    long long,
    unsigned long long,
    double,
    std::string
>;
} // namespace detail

export namespace net {

enum class log_format { syslog, jsonl };

// Concepts for type categorization in convert_to_value
template<typename T>
concept exact_value_type = std::same_as<std::remove_cvref_t<T>, std::nullptr_t> or
                           std::same_as<std::remove_cvref_t<T>, bool> or
                           std::same_as<std::remove_cvref_t<T>, int> or
                           std::same_as<std::remove_cvref_t<T>, unsigned int> or
                           std::same_as<std::remove_cvref_t<T>, long> or
                           std::same_as<std::remove_cvref_t<T>, unsigned long> or
                           std::same_as<std::remove_cvref_t<T>, long long> or
                           std::same_as<std::remove_cvref_t<T>, unsigned long long> or
                           std::same_as<std::remove_cvref_t<T>, double> or
                           std::same_as<std::remove_cvref_t<T>, std::string>;

template<typename T>
concept c_string_type = std::same_as<std::remove_cvref_t<T>, const char*> or
                        std::same_as<std::remove_cvref_t<T>, char*>;

template<typename T>
concept string_view_convertible = not exact_value_type<T> and
                                  not c_string_type<T> and
                                  std::convertible_to<T, std::string_view>;

template<typename T>
concept integral_convertible = not exact_value_type<T> and
                               not c_string_type<T> and
                               not string_view_convertible<T> and
                               std::integral<std::remove_cvref_t<T>>;

template<typename T>
concept floating_convertible = not exact_value_type<T> and
                               not c_string_type<T> and
                               not string_view_convertible<T> and
                               not integral_convertible<T> and
                               std::floating_point<std::remove_cvref_t<T>>;

template<typename T>
concept string_convertible = not exact_value_type<T> and
                             not c_string_type<T> and
                             not string_view_convertible<T> and
                             not integral_convertible<T> and
                             not floating_convertible<T> and
                             std::convertible_to<T, std::string>;

// Generic concept for types with operator<< - must be last fallback
// Note: operator<< returns std::basic_ostream<CharT, Traits>& (not stringstream&),
// so we check that it returns something convertible to std::ostream&
template<typename T>
concept streamable = not exact_value_type<T> and
                     not c_string_type<T> and
                     not string_view_convertible<T> and
                     not integral_convertible<T> and
                     not floating_convertible<T> and
                     not string_convertible<T> and
                     requires(std::stringstream& ss, const T& v) {
                         { ss << v } -> std::convertible_to<std::ostream&>;
                     };

struct level_manip {
    syslog::severity sev;
    std::string_view msg_id;
};

class structured_log_stream {
private:

    // Process-wide defaults inherited by each thread on first slog use. Lets main
    // configure yardb/yarproxy before workers start; workers then copy these values.
    // Raw ostream* redirects stay thread-local (stack captures must not leak into
    // workers). A shared_ptr capture may be published so HTTP handler threads can
    // join a test/process sink without dangling.
    struct process_defaults
    {
        syslog::severity log_level = syslog::severity::debug;
        log_format format = log_format::jsonl;
        std::string app_name = "slog";
        std::string sd_id = "slog";
        int facility_value = 1;  // user facility
        std::shared_ptr<std::ostream> shared_output;
    };

    // Per-thread configuration, redirect target, and in-flight entry. Concurrent
    // slog << … << flush on different threads no longer share entry buffers.
    struct thread_state
    {
        syslog::severity log_level = syslog::severity::debug;
        log_format format = log_format::jsonl;
        std::string app_name = "slog";
        std::string sd_id = "slog";
        int facility_value = 1;

        std::unique_ptr<std::ofstream> file_stream;
        std::shared_ptr<std::ostream> shared_output;
        std::ostream* output_stream = &std::clog;

        std::string hostname;
        std::string procid;
        bool metadata_cached = false;

        bool entry_enabled = false;
        bool entry_active = false;  // true between level_manip and flush (or throw cleanup)
        syslog::severity entry_severity = syslog::severity::debug;
        std::string_view entry_msg_id = std::string_view{};
        std::flat_map<detail::field_name_type, detail::value> structured_fields;
        std::stringstream human_message;
    };

    static std::mutex& process_mutex()
    {
        static std::mutex mutex;
        return mutex;
    }

    static process_defaults& process_config()
    {
        static process_defaults defaults{};
        return defaults;
    }

    static std::mutex& shared_ostream_mutex()
    {
        // Serialize writes to cout/cerr/clog and to any process-shared capture.
        static std::mutex mutex;
        return mutex;
    }

    static bool is_shared_standard_stream(const std::ostream* stream) noexcept
    {
        return stream == &std::cout or stream == &std::cerr or stream == &std::clog;
    }

    static bool needs_shared_ostream_lock(const thread_state& local) noexcept
    {
        return local.shared_output != nullptr or is_shared_standard_stream(local.output_stream);
    }

    static thread_state& state()
    {
        thread_local thread_state local{};
        thread_local bool initialized = false;
        if (not initialized)
        {
            std::lock_guard lock{process_mutex()};
            const auto& defaults = process_config();
            local.log_level = defaults.log_level;
            local.format = defaults.format;
            local.app_name = defaults.app_name;
            local.sd_id = defaults.sd_id;
            local.facility_value = defaults.facility_value;
            local.shared_output = defaults.shared_output;
            local.output_stream = local.shared_output ? local.shared_output.get() : &std::clog;
            initialized = true;
        }
        return local;
    }

    static void publish_process_defaults(const thread_state& local)
    {
        std::lock_guard lock{process_mutex()};
        auto& defaults = process_config();
        defaults.log_level = local.log_level;
        defaults.format = local.format;
        defaults.app_name = local.app_name;
        defaults.sd_id = local.sd_id;
        defaults.facility_value = local.facility_value;
    }

    static std::string get_severity_str(syslog::severity severity)
    {
        switch (severity) {
            case syslog::severity::debug:     return "debug";
            case syslog::severity::info:      return "info";
            case syslog::severity::notice:    return "notice";
            case syslog::severity::warning:   return "warning";
            case syslog::severity::error:     return "error";
            case syslog::severity::critical:  return "critical";
            case syslog::severity::alert:     return "alert";
            case syslog::severity::emergency: return "emergency";
            default:                          return "info";
        }
    }

    static std::string json_escape(std::string_view s) {
        std::string esc;
        esc.reserve(s.size());
        for (char c : s) {
            switch (c) {
                case '"':  esc += "\\\""; break;
                case '\\': esc += "\\\\"; break;
                case '\b': esc += "\\b";  break;
                case '\f': esc += "\\f";  break;
                case '\n': esc += "\\n";  break;
                case '\r': esc += "\\r";  break;
                case '\t': esc += "\\t";  break;
                default:   esc += c;      break;
            }
        }
        return esc;
    }

    static std::string sd_escape(const std::string& s) {
        std::string esc;
        esc.reserve(s.size());
        for (char c : s) {
            if (c == '"' or c == '\\' or c == ']') esc += '\\';
            esc += c;
        }
        return esc;
    }

    static std::string value_to_str(const detail::value& v) {
        return std::visit([](auto&& arg){
            using T = std::decay_t<decltype(arg)>;
            if constexpr (std::is_same_v<T, std::nullptr_t>) return "null"s;
            if constexpr (std::is_same_v<T, bool>)           return arg ? "true"s : "false"s;
            if constexpr (std::is_same_v<T, std::string>)   return arg;
            if constexpr (std::is_integral_v<T>)             return std::to_string(arg);
            if constexpr (std::is_floating_point_v<T>)       return std::to_string(arg);
            return ""s;  // Should never reach here
        }, v);
    }

    static void value_to_json(std::ostream& os, const detail::value& v) {
        std::visit([&os](auto&& arg) {
            using T = std::decay_t<decltype(arg)>;
            if constexpr (std::is_same_v<T, std::string>) {
                os << '"' << json_escape(arg) << '"';
            } else if constexpr (std::is_same_v<T, std::nullptr_t>) {
                os << "null";
            } else if constexpr (std::is_same_v<T, bool>) {
                os << (arg ? "true" : "false");
            } else if constexpr (std::is_integral_v<T> or std::is_floating_point_v<T>) {
                os << arg;
            }
        }, v);
    }

    static void ensure_metadata_cached(thread_state& local) {
        if (not local.metadata_cached) {
            char host[posix::ni_maxhost];
            if (posix::gethostname(host, posix::ni_maxhost) == 0) {
                local.hostname = host;
            } else {
                local.hostname = "localhost";
            }
            local.procid = std::to_string(posix::getpid());
            local.metadata_cached = true;
        }
    }

    static std::string generate_timestamp() {
        auto now = std::chrono::system_clock::now();
        return detail::format_timestamp(now);
    }

    // Helper to convert any type to the appropriate variant type
    // Optimized with concepts for better compile-time dispatch
    template<exact_value_type T>
    static detail::value convert_to_value(T&& v) {
        return std::forward<T>(v);
    }

    // C-strings (const char*, char*) are handled separately even though they're convertible
    // to std::string, because:
    // 1. Template overload resolution: more specific (c_string_type) is checked first
    // 2. Concept dependencies: c_string_type is used to exclude C-strings from other
    //    concepts (string_view_convertible, integral_convertible, etc.)
    // 3. Clear intent: explicit handling for C-strings vs. other string-like types
    // Both do the same conversion (std::string{v}), but the separation ensures proper
    // ordering and prevents C-strings from matching string_view_convertible or other
    // concepts in the chain
    template<c_string_type T>
    static detail::value convert_to_value(T v) {
        // getenv() and other C APIs return nullptr; std::string{nullptr} is UB and
        // throws (libstdc++) or crashes (libc++). Map null to the variant's nullptr
        // so the entry can finish and flush() can complete.
        if (v == nullptr) {
            return nullptr;
        }
        return std::string{v};
    }

    template<string_view_convertible T>
    static detail::value convert_to_value(T&& v) {
        return std::string{v};
    }

    template<integral_convertible T>
    static detail::value convert_to_value(T v) {
        return static_cast<long long>(v);
    }

    template<floating_convertible T>
    static detail::value convert_to_value(T v) {
        return static_cast<double>(v);
    }

    // Special handling for std::error_code - provides more informative format than standard operator<<
    // Standard operator<< outputs: "generic:17" (category:value)
    // Our format outputs: "17 (File exists)" (value + human-readable message)
    // This is more useful for logging because it includes the error message
    static detail::value convert_to_value(const std::error_code& ec) {
        return std::to_string(ec.value()) + " (" + ec.message() + ")";
    }

    // Handles types convertible to std::string (but NOT C-strings, which are handled above)
    // This catches other string-like types that aren't exact matches
    template<string_convertible T>
    static detail::value convert_to_value(T&& v) {
        return std::string{v};
    }

    // Generic fallback: any type with operator<< - convert via stringstream
    // This handles chrono types (hh_mm_ss, day, month, year, year_month_day) and any other streamable types
    // ADL will find custom operator<< implementations (e.g., net::operator<< for hh_mm_ss)
    template<streamable T>
    static detail::value convert_to_value(const T& v) {
        auto ss = std::stringstream{};
        ss << v;
        return ss.str();
    }

    static void output(thread_state& local) {
        if (not local.entry_enabled) return;

        ensure_metadata_cached(local);
        const auto timestamp = generate_timestamp();

        std::stringstream full_line;

        if (local.format == log_format::jsonl) {
            full_line << "{"
                      << "\"time\":\"" << timestamp << "\","
                      << "\"host\":\"" << json_escape(local.hostname) << "\","
                      << "\"app\":\"" << json_escape(local.app_name) << "\","
                      << "\"pid\":\"" << local.procid << "\","
                      << "\"level\":\"" << get_severity_str(local.entry_severity) << "\","
                      << "\"source\":\"" << json_escape(local.sd_id) << "\"";

            if (not local.entry_msg_id.empty()) {
                full_line << ",\"msg_id\":\"" << json_escape(local.entry_msg_id) << "\"";
            }

            full_line << ",\"message\":\"" << json_escape(local.human_message.str()) << "\"";

            for (const auto& [k, v] : local.structured_fields) {
                full_line << ",\"" << json_escape(k) << "\":";
                value_to_json(full_line, v);
            }
            full_line << "}";

        } else {  // syslog (RFC 5424)
            int pri = local.facility_value * 8 + static_cast<int>(local.entry_severity);
            full_line << "<" << pri << ">1 " << timestamp << " " << local.hostname << " "
                      << local.app_name << " " << local.procid << " "
                      << (local.entry_msg_id.empty() ? "-" : local.entry_msg_id);  // MSGID

            if (local.structured_fields.empty()) {
                full_line << " - ";  // NILVALUE for SD
            } else {
                full_line << " [" << local.sd_id;
                for (const auto& [k, v] : local.structured_fields) {
                    full_line << " " << k << "=\"" << sd_escape(value_to_str(v)) << "\"";
                }
                full_line << "]";
            }

            full_line << " \xEF\xBB\xBF" << local.human_message.str();  // Space + BOM + MSG
        }

        std::string line = full_line.str();

        if (local.output_stream) {
            if (needs_shared_ostream_lock(local)) {
                std::lock_guard lock{shared_ostream_mutex()};
                *local.output_stream << line << '\n';
            } else {
                *local.output_stream << line << '\n';
            }
        }
    }

    // Drop a partial entry after a mid-entry throw so the next log on this thread
    // starts clean. No process mutex is held across an entry anymore — TLS entry
    // state is enough for concurrent threads, and throw recovery is local.
    static void abandon_entry(thread_state& local) noexcept
    {
        local.entry_active = false;
        local.entry_enabled = false;
        local.entry_msg_id = {};
        local.structured_fields.clear();
        local.human_message.str("");
        local.human_message.clear();
    }

    template<class F>
    static void run_in_entry(thread_state& local, F&& f)
    {
        try
        {
            f();
        }
        catch(...)
        {
            abandon_entry(local);
            throw;
        }
    }

public:
    // Configuration (instance methods) - chained for fluent API
    // C++-idiomatic getters and setters using bare names with overloads

    // Query method to check if a severity level would be logged
    bool is_enabled(syslog::severity s) const {
        auto& local = state();
        return static_cast<int>(s) <= static_cast<int>(local.log_level);
    }

    syslog::severity log_level() const {
        return state().log_level;
    }
    structured_log_stream& log_level(syslog::severity level) {
        auto& local = state();
        local.log_level = level;
        publish_process_defaults(local);
        return *this;
    }

    log_format format() const {
        return state().format;
    }
    structured_log_stream& format(log_format f) {
        auto& local = state();
        local.format = f;
        publish_process_defaults(local);
        return *this;
    }

    const std::string& app_name() const {
        return state().app_name;
    }
    structured_log_stream& app_name(const std::string& name) {
        auto& local = state();
        local.app_name = name;
        publish_process_defaults(local);
        return *this;
    }

    const std::string& sd_id() const {
        return state().sd_id;
    }
    structured_log_stream& sd_id(const std::string& id) {
        auto& local = state();
        local.sd_id = id;
        publish_process_defaults(local);
        return *this;
    }

    int facility() const {
        return state().facility_value;
    }
    structured_log_stream& facility(int f) {
        auto& local = state();
        local.facility_value = f;
        publish_process_defaults(local);
        return *this;
    }
    structured_log_stream& facility(syslog::facility f) {
        auto& local = state();
        local.facility_value = static_cast<int>(f);
        publish_process_defaults(local);
        return *this;
    }

    // File redirect is thread-local (each worker would need its own open).
    structured_log_stream& redirect(const std::string& file_path) {
        auto& local = state();
        local.shared_output.reset();
        if (file_path.empty()) {
            local.file_stream.reset();
            local.output_stream = &std::cout;
        } else {
            local.file_stream = std::make_unique<std::ofstream>(file_path, std::ios::app);
            if (local.file_stream->is_open()) {
                local.output_stream = local.file_stream.get();
            } else {
                local.file_stream.reset();
                local.output_stream = &std::cout;
            }
        }
        return *this;
    }

    // Thread-local redirect. Does not publish to workers — use the shared_ptr
    // overload when HTTP handler threads must write into the same capture.
    structured_log_stream& redirect(std::ostream& os) {
        auto& local = state();
        local.file_stream.reset();
        local.shared_output.reset();
        local.output_stream = &os;
        if (is_shared_standard_stream(&os))
        {
            std::lock_guard lock{process_mutex()};
            process_config().shared_output.reset();
        }
        return *this;
    }

    // Process-wide capture inherited by threads that have not used slog yet.
    // Lifetime is owned by the shared_ptr (tests: make_shared<stringstream>).
    structured_log_stream& redirect(std::shared_ptr<std::ostream> os) {
        auto& local = state();
        local.file_stream.reset();
        local.shared_output = std::move(os);
        local.output_stream = local.shared_output ? local.shared_output.get() : &std::clog;
        {
            std::lock_guard lock{process_mutex()};
            process_config().shared_output = local.shared_output;
        }
        return *this;
    }

    // Streaming interface — entry state is thread-local, so concurrent threads
    // do not need a process-wide mutex held for the lifetime of the entry.
    structured_log_stream& operator<<(const level_manip& manip) {
        auto& local = state();
        local.entry_active = true;
        local.entry_severity = manip.sev;
        local.entry_msg_id   = manip.msg_id;
        local.entry_enabled  = static_cast<int>(manip.sev) <= static_cast<int>(local.log_level);

        // Early exit: skip expensive buffer clearing if disabled
        if (not local.entry_enabled) {
            return *this;
        }

        run_in_entry(local, [&] {
            local.structured_fields.clear();
            local.human_message.str("");
            local.human_message.clear();
        });

        return *this;
    }

    // Structured fields: {"key", value} or std::pair{"key", value}
    // Optimized: uses emplace to avoid double conversion
    // Handles both lvalue and rvalue references via forwarding reference
    template<class K, class V>
    structured_log_stream& operator<<(std::pair<K, V>&& kv) {
        auto& local = state();
        if (local.entry_enabled) {
            run_in_entry(local, [&] {
                local.structured_fields.emplace(std::piecewise_construct,
                                          std::forward_as_tuple(kv.first),
                                          std::forward_as_tuple(convert_to_value(std::forward<V>(kv.second))));
            });
        }
        return *this;
    }

    // Source location support (C++20)
    structured_log_stream& operator<<(const std::source_location& loc) {
        auto& local = state();
        if (local.entry_enabled) {
            run_in_entry(local, [&] {
                using namespace std::string_view_literals;
                local.structured_fields.emplace(std::piecewise_construct,
                                         std::forward_as_tuple("file"sv),
                                         std::forward_as_tuple(convert_to_value(loc.file_name())));
                local.structured_fields.emplace(std::piecewise_construct,
                                         std::forward_as_tuple("line"sv),
                                         std::forward_as_tuple(convert_to_value(loc.line())));
                local.structured_fields.emplace(std::piecewise_construct,
                                         std::forward_as_tuple("function"sv),
                                         std::forward_as_tuple(convert_to_value(loc.function_name())));
            });
        }
        return *this;
    }

    // Intermediate operators mutate this thread's in-flight entry only
    template<typename T>
    requires (not std::is_same_v<std::remove_cvref_t<T>, level_manip> and
              not std::is_same_v<std::remove_cvref_t<T>, syslog::severity> and
              not std::is_same_v<std::remove_cvref_t<T>, std::source_location>)
    structured_log_stream& operator<<(T&& t) {
        auto& local = state();
        if (local.entry_enabled) {
            run_in_entry(local, [&] {
                local.human_message << std::forward<T>(t);
            });
        }
        return *this;
    }

    // flush / endl - calls flush()
    structured_log_stream& operator<<(std::ostream& (*)(std::ostream&)) {
        // For any manipulator (endl, flush), call flush()
        return flush();
    }

    structured_log_stream& flush() {
        auto& local = state();
        try {
            if (local.entry_enabled) {
                output(local);
            }
            local.entry_active = false;
            local.entry_enabled = false;
        } catch (...) {
            abandon_entry(local);
            throw;
        }
        return *this;
    }
};

// Global facade — mutable state lives in thread_local storage accessed via methods.
inline structured_log_stream slog;

// Function object for level manipulators (supports both error and error("msgid"))
struct level_manip_functor {
    syslog::severity sev;

    // Implicit conversion to level_manip (for slog << error)
    operator level_manip() const { return {sev, std::string_view{}}; }

    // Function call operator with no args (for slog << error()) - internal/test use only
    level_manip operator()() const { return {sev, std::string_view{}}; }

    // Function call operator with msgid (for slog << error("msgid"))
    level_manip operator()(std::string_view id) const { return {sev, id}; }
};

// Backward compatibility: Global manipulator objects (can be used without parentheses)
// These work as both objects (slog << error) and functions (slog << error("msgid"))
inline constexpr level_manip_functor emergency{syslog::severity::emergency};
inline constexpr level_manip_functor alert   {syslog::severity::alert};
inline constexpr level_manip_functor critical{syslog::severity::critical};
inline constexpr level_manip_functor error   {syslog::severity::error};
inline constexpr level_manip_functor warning {syslog::severity::warning};
inline constexpr level_manip_functor notice  {syslog::severity::notice};
inline constexpr level_manip_functor info    {syslog::severity::info};
inline constexpr level_manip_functor debug   {syslog::severity::debug};

// Support for level_manip_functor in streams (implicitly converts to level_manip)
inline structured_log_stream& operator<<(structured_log_stream& stream, const level_manip_functor& functor) {
    return stream << static_cast<level_manip>(functor);
}

[[nodiscard]] inline auto& flush(structured_log_stream& ss) {
    [[maybe_unused]] auto& _ = ss.flush();
    return ss;
}

} // namespace net
