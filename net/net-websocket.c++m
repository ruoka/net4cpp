export module net:websocket;
export import :websocket_frame;
import :connector;
import :endpointstream;
import :http_headers;
import :uri;
import :utils;
import :uuid;
import cryptic;
import std;

export namespace net::websocket {

using namespace std::string_literals;
using namespace std::string_view_literals;

// RFC 6455 §1.3 magic GUID
inline constexpr auto accept_guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"sv;

namespace detail {

// RFC 6455 §5.3 wants masking keys from a strong source of entropy. Drawn
// straight from std::random_device (see net::random_bytes); thread_local
// because the client masks every frame it sends.
inline std::uint32_t random_u32()
{
    static_assert(sizeof(std::random_device::result_type) >= 4);
    thread_local auto device = std::random_device{};
    return static_cast<std::uint32_t>(device());
}

inline std::string random_websocket_key()
{
    const auto bytes = net::random_bytes<16>();
    return cryptic::base64::encode(std::as_bytes(std::span{bytes}));
}

inline frame mask_frame(frame f)
{
    f.masked = true;
    f.masking_key = random_u32();
    return f;
}

inline bool write_masked(std::ostream& os, frame f)
{
    return write_frame(os, mask_frame(std::move(f)));
}

inline std::string normalize_path(std::string_view path)
{
    if(path.empty())
        return "/"s;
    if(path.front() == '/')
        return std::string{path};
    return "/"s + std::string{path};
}

// RFC 6455 §4.1 / RFC 7230: Host is uri-host [ ":" port ] with a numeric
// port. getaddrinfo service names ("http") must not appear after ':'.
// Bare IPv6 literals must be bracketed so Host: ::1:8080 is not emitted.
inline std::string host_header(std::string_view host, std::string_view port)
{
    const auto already_bracketed =
        host.size() >= 2 and host.front() == '[' and host.back() == ']';
    // Any unbracketed host containing ':' is an IP-literal (IPv6 / future).
    const auto needs_brackets =
        not already_bracketed and host.find(':') != std::string_view::npos;

    auto header = needs_brackets
        ? ("["s + std::string{host} + "]"s)
        : std::string{host};
    if(not port.empty()
       and std::ranges::all_of(port, [](unsigned char c) {
               return std::isdigit(c) != 0;
           }))
    {
        header.push_back(':');
        header.append(port);
    }
    return header;
}

inline bool contains_http_line_break(std::string_view value)
{
    return std::ranges::any_of(value, [](char c) {
        return c == '\r' or c == '\n' or c == '\0';
    });
}

// Cap upgrade response head so a hostile peer cannot grow memory without bound.
inline constexpr auto max_upgrade_response_bytes = std::size_t{16 * 1024};

// Read status line + headers through the terminating blank line. wait_for only
// means "some byte is readable"; operator>>/getline would still block forever
// on a truncated response, so every read that may block is deadline-bounded.
inline std::string read_upgrade_response_head(
    net::endpointstream& stream,
    std::chrono::steady_clock::time_point deadline)
{
    auto head = ""s;
    head.reserve(256);
    while(true)
    {
        // Same LF-tolerant blank line as http::server::read_request_head
        // (RFC 7230 §3.5). "\r\n\r\n" does not end with "\n\n" — check both.
        if((head.size() >= 4 and head.ends_with("\r\n\r\n"))
           or (head.size() >= 2 and head.ends_with("\n\n")))
            return head;

        if(head.size() >= max_upgrade_response_bytes)
            throw std::runtime_error{
                "websocket upgrade failed: response headers too large"};

        if(stream.rdbuf() == nullptr or stream.rdbuf()->in_avail() <= 0)
        {
            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
                deadline - std::chrono::steady_clock::now());
            if(remaining.count() <= 0 or not stream.wait_for(remaining))
                throw std::runtime_error{
                    "websocket upgrade failed: handshake timeout waiting for response"};
        }

        const auto ch = stream.get();
        if(not stream.good())
            throw std::runtime_error{
                "websocket upgrade failed: connection closed during handshake"};
        head.push_back(static_cast<char>(ch));
    }
}

} // namespace detail

inline std::string sec_websocket_accept(std::string_view client_key)
{
    auto hasher = cryptic::sha1{};
    hasher.update(client_key).update(accept_guid);
    return hasher.digest().base64();
}

// RFC 7230 list / RFC 6455 §4.1: Upgrade and Connection carry comma-separated
// tokens. Substring match treats Upgrade: websocketx / Connection: upgradeable
// as a handshake and can desync from proxies that require exact tokens.
inline bool header_token_contains(std::string value, std::string_view token)
{
    utils::ascii_to_lower(value);
    auto needle = std::string{token};
    utils::ascii_to_lower(needle);

    for(const auto part : std::string_view{value} | std::views::split(','))
    {
        if(utils::trim(std::string_view{part}) == needle)
            return true;
    }
    return false;
}

inline bool is_websocket_upgrade(const ::http::headers& hs)
{
    if(not hs.contains("upgrade") or not hs.contains("connection"))
        return false;
    return header_token_contains(hs["upgrade"], "websocket"sv)
        and header_token_contains(hs["connection"], "upgrade"sv);
}

// nullopt = no outbound text frame; engaged = send that payload.
using text_reply = std::optional<std::string>;
using text_handler = std::function<text_reply(std::string_view)>;
using text_sink = std::function<void(std::string_view)>;

// Best-effort wait for the peer close frame after we initiate close (RFC 6455
// §7.1.1). Past this budget, close() force-closes the TCP stream.
inline constexpr auto default_close_drain_timeout = std::chrono::milliseconds{2000};

inline void close_session(std::iostream& stream, std::uint16_t code)
{
    write_frame(stream, make_close_frame(code));
}

namespace detail {

// Read and answer one client frame. False ends the session.
inline bool serve_text_frame(std::iostream& stream, const text_handler& on_text)
{
    auto incoming = frame{};
    switch(read_frame(stream, incoming))
    {
    case frame_read::ok:
        break;
    case frame_read::io_error:
        return false;
    case frame_read::message_too_big:
        close_session(stream, close_message_too_big);
        return false;
    case frame_read::protocol_error:
        close_session(stream, close_protocol_error);
        return false;
    }

    // RFC 6455 §5.1: every client-to-server frame MUST be masked.
    if(not incoming.masked)
    {
        close_session(stream, close_protocol_error);
        return false;
    }

    switch(incoming.op)
    {
    case opcode::ping:
        return write_frame(stream, make_pong_frame(incoming.payload));

    case opcode::pong:
        return true;

    case opcode::close:
        write_frame(stream, make_close_frame(incoming.payload));
        return false;

    case opcode::text:
    {
        // No reassembly: FIN=0 is unsupported (close 1003), not silently dropped.
        if(not incoming.fin)
        {
            close_session(stream, close_unsupported_data);
            return false;
        }
        if(not is_valid_utf8(std::span<const std::byte>{incoming.payload}))
        {
            close_session(stream, close_invalid_payload);
            return false;
        }
        if(not on_text)
            return true;
        const auto text = payload_as_string(incoming);
        if(auto reply = on_text(text))
            return write_frame(stream, make_text_frame(*reply));
        return true;
    }

    case opcode::binary:
    case opcode::continuation:
        close_session(stream, close_unsupported_data);
        return false;

    default:
        close_session(stream, close_protocol_error);
        return false;
    }
}

} // namespace detail

// Drive a WebSocket session until close/error. Server frames are unmasked.
// v1 policy: complete text frames only (no fragmentation / binary); invalid
// UTF-8 → 1007; structural frame errors → 1002 / 1009.
inline void run_text_session(std::iostream& stream, const text_handler& on_text)
{
    while(stream and detail::serve_text_frame(stream, on_text))
    {
    }
}

inline constexpr auto default_ping_interval = std::chrono::milliseconds{30'000};
inline constexpr auto default_frame_timeout = std::chrono::milliseconds{30'000};

// Liveness limits for a socket-backed server session. Without them a peer that
// completes the upgrade and then goes quiet holds its handler thread forever.
// A peer silent for ping_interval gets a ping; silence for another interval
// closes with 1001. frame_timeout caps a frame from its first byte to its last,
// so a peer cannot dribble a 1 MiB frame inside the idle gap. Zero disables either.
struct session_limits
{
    std::chrono::milliseconds ping_interval = default_ping_interval;
    std::chrono::milliseconds frame_timeout = default_frame_timeout;
};

// Same frame policy as the iostream overload, plus session_limits.
inline void run_text_session(net::endpointstream& stream, const text_handler& on_text, session_limits limits = {})
{
    stream.read_timeout(limits.ping_interval);
    stream.read_deadline(std::nullopt);
    auto awaiting_pong = false;
    while(stream)
    {
        if(stream.peek() == std::char_traits<char>::eof())
        {
            if(not stream.read_timed_out() or stream.shut_down())
                return;
            stream.clear();
            if(awaiting_pong)
            {
                close_session(stream, close_going_away);
                return;
            }
            if(not write_frame(stream, make_ping_frame()))
                return;
            awaiting_pong = true;
            continue;
        }

        // Any frame is proof of life, not only the pong.
        awaiting_pong = false;
        if(limits.frame_timeout.count() > 0)
            stream.read_deadline(std::chrono::steady_clock::now() + limits.frame_timeout);
        const auto keep_going = detail::serve_text_frame(stream, on_text);
        stream.read_deadline(std::nullopt);
        if(not keep_going)
            return;
    }
}

// Client connection: TCP + HTTP upgrade, then masked text send / unmasked recv.
// Same v1 policy as the server (text-only, no fragments, UTF-8, fail closed).
class connection
{
public:

    connection(connection&&) noexcept = default;
    connection& operator=(connection&&) noexcept = default;

    [[nodiscard]] explicit operator bool() const noexcept
    {
        return not m_closed and static_cast<bool>(m_stream);
    }

    // Send one complete text message (client frames are masked).
    [[nodiscard]] bool send(std::string_view text)
    {
        if(not *this)
            return false;
        return detail::write_masked(m_stream, make_text_frame(text));
    }

    // Next text message, or nullopt when the session ends (close / protocol / IO).
    // Automatically answers ping with a masked pong.
    [[nodiscard]] std::optional<std::string> recv()
    {
        while(*this)
        {
            auto incoming = frame{};
            switch(read_frame(m_stream, incoming))
            {
            case frame_read::ok:
                break;
            case frame_read::io_error:
                m_closed = true;
                return std::nullopt;
            case frame_read::message_too_big:
                fail_close(close_message_too_big);
                return std::nullopt;
            case frame_read::protocol_error:
                fail_close(close_protocol_error);
                return std::nullopt;
            }

            // RFC 6455 §5.1: server-to-client frames MUST NOT be masked.
            if(incoming.masked)
            {
                fail_close(close_protocol_error);
                return std::nullopt;
            }

            switch(incoming.op)
            {
            case opcode::ping:
                if(not detail::write_masked(m_stream, make_pong_frame(incoming.payload)))
                {
                    m_closed = true;
                    return std::nullopt;
                }
                break;

            case opcode::pong:
                break;

            case opcode::close:
                detail::write_masked(m_stream, make_close_frame(incoming.payload));
                m_closed = true;
                return std::nullopt;

            case opcode::text:
                if(not incoming.fin)
                {
                    fail_close(close_unsupported_data);
                    return std::nullopt;
                }
                if(not is_valid_utf8(std::span<const std::byte>{incoming.payload}))
                {
                    fail_close(close_invalid_payload);
                    return std::nullopt;
                }
                return payload_as_string(incoming);

            case opcode::binary:
            case opcode::continuation:
                fail_close(close_unsupported_data);
                return std::nullopt;

            default:
                fail_close(close_protocol_error);
                return std::nullopt;
            }
        }
        return std::nullopt;
    }

    // Call on_text for each text message until the session ends.
    void read_loop(const text_sink& on_text)
    {
        while(auto msg = recv())
        {
            if(on_text)
                on_text(*msg);
        }
    }

    // Initiate close; best-effort wait for peer close frame, then force-close.
    // Without a drain budget a silent peer, endless text/ping, or a truncated
    // frame would hang forever in blocking recv — RFC 6455 §7.1.1 allows the
    // client to time out. wait_for alone is not enough: once any byte is
    // readable, read_frame() must also be deadline-bounded.
    void close(
        std::uint16_t code = close_normal,
        std::chrono::milliseconds drain_timeout = default_close_drain_timeout)
    {
        if(m_closed)
            return;
        detail::write_masked(m_stream, make_close_frame(code));
        const auto deadline = std::chrono::steady_clock::now() + drain_timeout;
        while(m_stream and not m_closed)
        {
            if(std::chrono::steady_clock::now() >= deadline)
                break;
            auto incoming = frame{};
            const auto status = read_frame(m_stream, incoming, [&] {
                // Prefer already-buffered bytes; wait_for only polls the socket.
                if(m_stream.rdbuf() != nullptr and m_stream.rdbuf()->in_avail() > 0)
                    return true;
                const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
                    deadline - std::chrono::steady_clock::now());
                if(remaining.count() <= 0)
                    return false;
                return m_stream.wait_for(remaining);
            });
            if(status != frame_read::ok)
                break;
            if(incoming.op == opcode::close)
                break;
            if(incoming.op == opcode::ping)
                detail::write_masked(m_stream, make_pong_frame(incoming.payload));
        }
        m_closed = true;
        m_stream.close();
    }

private:

    friend connection connect(
        std::string_view host,
        std::string_view port,
        std::string_view path,
        const std::chrono::milliseconds& timeout); // defined below

    explicit connection(net::endpointstream stream)
        : m_stream{std::move(stream)}
    {
    }

    void fail_close(std::uint16_t code)
    {
        if(not m_closed and m_stream)
            detail::write_masked(m_stream, make_close_frame(code));
        m_closed = true;
    }

    net::endpointstream m_stream;
    bool m_closed = false;
};

// TCP connect + HTTP Upgrade handshake. Throws std::runtime_error on a failed
// upgrade (TCP failure throws via net::connect). `timeout` bounds the TCP
// connect and the full upgrade-response read (status line + headers through the
// terminating blank line). A peer that accepts then stays silent — or sends a
// truncated response — must not hang forever in blocking reads.
inline connection connect(
    std::string_view host,
    std::string_view port,
    std::string_view path = "/"sv,
    const std::chrono::milliseconds& timeout = net::default_connect_timeout)
{
    const auto request_path = detail::normalize_path(path);
    if(detail::contains_http_line_break(host)
       or detail::contains_http_line_break(request_path))
        throw std::runtime_error{
            "websocket connect failed: host/path contains CR, LF, or NUL"};

    auto stream = net::connect(host, port, timeout);
    const auto key = detail::random_websocket_key();
    const auto expected_accept = sec_websocket_accept(key);
    const auto host_header = detail::host_header(host, port);

    stream << "GET " << request_path << " HTTP/1.1" << net::crlf
           << "Host: " << host_header << net::crlf
           << "Upgrade: websocket" << net::crlf
           << "Connection: Upgrade" << net::crlf
           << "Sec-WebSocket-Key: " << key << net::crlf
           << "Sec-WebSocket-Version: 13" << net::crlf
           << net::crlf << net::flush;

    const auto deadline = std::chrono::steady_clock::now() + timeout;
    const auto head = detail::read_upgrade_response_head(stream, deadline);

    auto parse = std::istringstream{head};
    auto version = ""s;
    auto status_code = ""s;
    auto reason = ""s;
    parse >> version >> status_code;
    std::getline(parse, reason);
    if(status_code != "101"s)
        throw std::runtime_error{"websocket upgrade failed: expected 101, got " + status_code};

    auto hs = ::http::headers{};
    parse >> hs >> net::crlf;
    if(not is_websocket_upgrade(hs))
        throw std::runtime_error{"websocket upgrade failed: missing Upgrade headers"};
    if(not hs.contains("sec-websocket-accept")
       or hs["sec-websocket-accept"] != expected_accept)
        throw std::runtime_error{"websocket upgrade failed: Sec-WebSocket-Accept mismatch"};

    return connection{std::move(stream)};
}

// Parse authority/path/query from `url` and upgrade. `ws` / `http` with an empty
// port resolve like HTTP (port 80). `wss` / `https` are rejected (no TLS in-repo).
// Fragment is not sent. Same handshake rules as the host/port/path overload.
inline connection connect(
    const net::uri& url,
    const std::chrono::milliseconds& timeout = net::default_connect_timeout)
{
    const auto host = static_cast<std::string_view>(url.host);
    if(host.empty())
        throw std::runtime_error{"websocket connect failed: URI has no host"};

    const auto scheme = static_cast<std::string_view>(url.scheme);
    const auto port = static_cast<std::string_view>(url.port);
    auto service = ""s;
    if(not port.empty())
        service = std::string{port};
    else if(scheme == "ws"sv or scheme == "http"sv)
        service = "http"s;
    else if(scheme == "wss"sv or scheme == "https"sv)
        throw std::runtime_error{
            "websocket connect failed: wss/https not supported (no TLS)"};
    else if(not scheme.empty())
        service = std::string{scheme};
    else
        throw std::runtime_error{"websocket connect failed: URI has no port"};

    auto path = std::string{static_cast<std::string_view>(url.path)};
    const auto query = static_cast<std::string_view>(url.query);
    if(not query.empty())
    {
        if(path.empty())
            path = "/"s;
        path.push_back('?');
        path.append(query);
    }

    return connect(host, service, path, timeout);
}

} // namespace net::websocket
