export module net:http_headers;
import :utils;
import :endpointstream;
import std;

export namespace http
{

class headers
{
public:

    using name = std::string;
    using value = std::string;

    bool contains(const name& n) const { return m_values.contains(n); }

    const value& operator[](const name& n) const { return m_values.at(n); }
    
    value& operator[](const name& n) { return m_values[n]; }
    
    void set(std::string_view n, std::string_view v)
    {
        auto lower_name = std::string{n};
        utils::ascii_to_lower(lower_name);
        m_values[std::move(lower_name)] = std::string{v};
    }

    // Missing → nullopt. Name is matched case-insensitively (same as set).
    std::optional<std::string_view> try_get(std::string_view n) const
    {
        auto key = std::string{n};
        utils::ascii_to_lower(key);
        if(auto it = m_values.find(key); it != m_values.end())
            return std::string_view{it->second};
        return std::nullopt;
    }

    // Missing → default_value. Never invents auth/origin — callers choose the default.
    value value_or(std::string_view n, value default_value) const
    {
        if(auto v = try_get(n))
            return value{*v};
        return default_value;
    }

    // Iterator support for range-based for loops
    auto begin() { return m_values.begin(); }
    auto end() { return m_values.end(); }
    auto begin() const { return m_values.begin(); }
    auto end() const { return m_values.end(); }

    friend std::istream& operator >> (std::istream&, headers&);
    friend std::ostream& operator << (std::ostream&, const headers&);

private:

    std::flat_map<name,value> m_values;
};

namespace detail
{

// RFC 9110 §5.6.2 token: the only characters allowed in a field name.
constexpr bool is_token_char(char ch) noexcept
{
    return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9')
        or std::string_view{"!#$%&'*+-.^_`|~"}.contains(ch);
}

// RFC 9110 §5.5: field values hold visible characters, SP, HTAB, and obs-text.
// A bare CR, NUL, or other control byte is rejected (RFC 9112 §2.2).
constexpr bool is_field_value_char(char ch) noexcept
{
    const auto byte = static_cast<unsigned char>(ch);
    return byte == '\t' or (byte >= 0x20 and byte != 0x7F);
}

// Optional whitespace is SP / HTAB only; utils::trim would also strip \v and \f.
constexpr std::string_view trim_ows(std::string_view s) noexcept
{
    const auto ows = [](char c) { return c == ' ' or c == '\t'; };
    const auto first = std::ranges::find_if_not(s, ows);
    const auto last = std::ranges::find_if_not(s | std::views::reverse, ows).base();
    return first < last ? std::string_view{first, last} : std::string_view{};
}

} // namespace detail

inline std::istream& operator >> (std::istream &is,  headers &hdrs)
{
    while(is.good())
    {
        // Only an empty line (CRLF or LF) ends the fields. Stopping at any line
        // that starts with CR (`\r\r\n`) hid the fields after it, such as a
        // Transfer-Encoding that read_request_head had already read. The final
        // LF stays for the caller's `>> net::crlf`, so a live socket is never
        // read past the head.
        if(is.peek() == '\n')
            break;
        if(is.peek() == '\r')
        {
            is.get();
            if(is.peek() == '\n')
                break;
            throw std::runtime_error{"malformed header line"};
        }

        std::string line;
        if(not std::getline(is, line))
            break;
        auto sv = std::string_view{line};
        if(sv.ends_with('\r'))
            sv.remove_suffix(1);

        // RFC 9112 §5.2: a field line that begins with SP or HTAB is obsolete
        // line folding. Reject it. Skipping the continuation drops a second
        // Content-Length token that a proxy may still honor.
        if(sv.front() == ' ' or sv.front() == '\t')
            throw std::runtime_error{"obsolete line folding"};

        const auto pos = sv.find(':');
        if(pos == std::string_view::npos)
            throw std::runtime_error{"malformed header line"};

        // RFC 9112 §5.1: no whitespace between the name and the colon. A proxy
        // that ignores `Content-Length : 5` would disagree on the body length.
        const auto name_sv = sv.substr(0, pos);
        if(name_sv.empty() or not std::ranges::all_of(name_sv, detail::is_token_char))
            throw std::runtime_error{"invalid header name"};

        const auto value_sv = detail::trim_ows(sv.substr(pos + 1));
        if(not std::ranges::all_of(value_sv, detail::is_field_value_char))
            throw std::runtime_error{"invalid header value"};

        auto name = std::string{name_sv};
        utils::ascii_to_lower(name);
        // RFC 7230 §3.3.2 / §3.3.3: multiple Content-Length values with a
        // differing field-value must be rejected. Collapsing via last-wins
        // enables request smuggling when a front-end proxy uses the first.
        if(name == "content-length" and hdrs.m_values.contains(name))
            throw std::runtime_error{"duplicate Content-Length header"};
        // RFC 7230 §5.4: more than one Host header field must be rejected.
        // Last-wins lets a second Host poison absolute URLs / cache keys
        // while a first-Host proxy still routes to the victim authority.
        if(name == "host" and hdrs.m_values.contains(name))
            throw std::runtime_error{"duplicate Host header"};
        hdrs.m_values[std::move(name)] = std::string{value_sv};
    }
    return is;
}

inline std::ostream& operator << (std::ostream &os, const headers &hdrs)
{
    for(const auto &[name,value] : hdrs.m_values)
        os << name << ": " << value << net::crlf;
    return os;
}

// Helper function to check if Accept header accepts JSON
inline bool accepts_json(const headers& hdr)
{
    using namespace std::string_literals;
    using namespace std::string_view_literals;
    if(not hdr.contains("accept"s))
        return true; // No Accept header means accept anything
    const auto accept_value = hdr["accept"s];
    return accept_value.contains("*/*"sv) or 
           accept_value.contains("application/json"sv) or
           accept_value.contains("application/*"sv);
}

} // namespace http

