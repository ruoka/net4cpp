export module net:sse;
import :endpointstream;
import std;

export namespace http::sse
{

using namespace std::string_literals;
using namespace std::string_view_literals;

namespace detail
{

inline void append_without(std::string& out, std::string_view text, std::string_view dropped)
{
    for(auto pos = text.find_first_of(dropped); pos != std::string_view::npos; pos = text.find_first_of(dropped))
    {
        out.append(text.substr(0, pos));
        text.remove_prefix(pos + 1);
    }
    out.append(text);
}

// Calls `line` for each line of `text`. SSE ends a line on CRLF, a bare CR, or
// a bare LF, so splitting on `\n` alone lets a CR start an attacker's field.
// A trailing line ending yields a final empty line.
inline void for_each_line(std::string_view text, const auto& line)
{
    for(;;)
    {
        const auto pos = text.find_first_of("\r\n"sv);
        line(text.substr(0, pos));
        if(pos == std::string_view::npos)
            return;
        text.remove_prefix(pos + (text.substr(pos, 2) == "\r\n"sv ? 2 : 1));
    }
}

} // namespace detail

// Append one SSE field line (`name: value\n`). CR and LF are dropped from both,
// so a value cannot end the line and start another field. Multi-line payloads
// go through format_event, which emits one `data:` field per line.
inline void append_field(std::string& out, std::string_view name, std::string_view value)
{
    detail::append_without(out, name, "\r\n"sv);
    out.append(": "sv);
    detail::append_without(out, value, "\r\n"sv);
    out.push_back('\n');
}

// Comment line (`: text\n`). Empty text yields `:\n` (valid heartbeat).
// Multi-line text becomes one comment line per line.
inline std::string format_comment(std::string_view text = {})
{
    if(text.empty())
        return ":\n"s;

    auto out = ""s;
    detail::for_each_line(text, [&out](std::string_view line) {
        out.push_back(':');
        if(not line.empty())
        {
            out.push_back(' ');
            out.append(line);
        }
        out.push_back('\n');
    });
    return out;
}

// Full event block ending with a blank line (dispatches to the client).
// Each line of `data` (CRLF, CR, or LF) becomes its own `data:` field.
// CR and LF are dropped from `event` and `id`, and NUL from `id` (clients
// ignore an id containing NUL). Both are omitted when empty, `retry_ms` when nullopt.
inline std::string format_event(
    std::string_view data,
    std::string_view event = {},
    std::string_view id = {},
    std::optional<std::chrono::milliseconds> retry_ms = std::nullopt)
{
    auto out = ""s;
    out.reserve(data.size() + event.size() + id.size() + 32);
    if(not event.empty())
        append_field(out, "event"sv, event);

    detail::for_each_line(data, [&out](std::string_view line) {
        append_field(out, "data"sv, line);
    });

    if(not id.empty())
    {
        auto clean_id = ""s;
        detail::append_without(clean_id, id, "\0"sv);
        append_field(out, "id"sv, clean_id);
    }

    if(retry_ms.has_value())
        append_field(out, "retry"sv, std::to_string(retry_ms->count()));

    out.push_back('\n');
    return out;
}

// Writer over an already-opened SSE response (headers already sent by http::server).
class session
{
public:

    explicit session(std::ostream& stream) noexcept
        : m_stream{stream}
    {
    }

    session(const session&) = delete;
    session& operator=(const session&) = delete;

    // Returns false after a write/flush failure; further sends are no-ops.
    bool send_event(
        std::string_view event,
        std::string_view data,
        std::string_view id = {},
        std::optional<std::chrono::milliseconds> retry_ms = std::nullopt)
    {
        return write_raw(format_event(data, event, id, retry_ms));
    }

    bool send_data(
        std::string_view data,
        std::string_view id = {},
        std::optional<std::chrono::milliseconds> retry_ms = std::nullopt)
    {
        return write_raw(format_event(data, ""sv, id, retry_ms));
    }

    bool send_comment(std::string_view text = {})
    {
        return write_raw(format_comment(text));
    }

    bool flush()
    {
        if(m_closed)
            return false;
        m_stream << net::flush;
        if(not m_stream.good())
        {
            m_closed = true;
            return false;
        }
        return true;
    }

    [[nodiscard]] bool closed() const noexcept
    {
        if(m_closed or not m_stream.good())
            return true;
        // http::server::stop() calls endpointstream::shutdown(), which does not
        // set iostream failbit until the next write. Without this latch, MCP
        // handlers that only poll closed() never observe stop() and
        // wait_for_handlers() deadlocks (inbound-queue tests; custom transports).
        if(auto* ep = dynamic_cast<const net::endpointstream*>(&m_stream))
            return ep->shut_down();
        return false;
    }

    [[nodiscard]] std::size_t bytes_out() const noexcept
    {
        return m_bytes_out;
    }

private:

    bool write_raw(std::string_view chunk)
    {
        if(m_closed or not m_stream.good())
        {
            m_closed = true;
            return false;
        }
        m_stream.write(chunk.data(), static_cast<std::streamsize>(chunk.size()));
        if(not m_stream.good())
        {
            m_closed = true;
            return false;
        }
        m_bytes_out += chunk.size();
        return flush();
    }

    std::ostream& m_stream;
    bool m_closed = false;
    std::size_t m_bytes_out = 0;
};

} // namespace http::sse
